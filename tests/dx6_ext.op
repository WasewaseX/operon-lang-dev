# dx-r6: loop-5 audit additions, fs mutate ops (denial contract under
# default-deny; success paths are grant-gated and exercised manually/by the
# redteam suite) + re_replace (full behavioral coverage, no caps needed).
frame proof {
    # re_replace: literal replacement via the bounded backtracking engine
    assert(re_replace("o", "foo", "0") == "f00")
    assert(re_replace("\\d+", "a1b22c", "#") == "a#b#c")
    assert(re_replace("x", "abc", "!") == "abc")
    assert(re_replace("l+", "lloll", "L") == "LoL")
    # empty pattern: Python re.sub parity, including end-of-string matches
    assert(re_replace("", "ab", "-") == "-a-b-")
    assert(re_replace("", "", "-") == "-")
    # replacement deletes when the replacement is empty
    assert(re_replace("\\s+", "a b   c", "") == "abc")

    # fs mutate ops under default-deny: catchable interference, no crash,
    # no capability leakage (the containment contract, same as std_fs.op)
    stress {
        fs_delete("/tmp/operon_dx6_denied_zz")
        assert(false)
    } rescue (e) {
        assert(e.kind == "interference")
    }
    stress {
        fs_rename("/tmp/operon_dx6_a_zz", "/tmp/operon_dx6_b_zz")
        assert(false)
    } rescue (e) {
        assert(e.kind == "interference")
    }
    stress {
        fs_mkdir("/tmp/operon_dx6_mkdir_zz")
        assert(false)
    } rescue (e) {
        assert(e.kind == "interference")
    }
}
main {
    promote("dx-r6: re_replace + fs-op containment OK")
}
