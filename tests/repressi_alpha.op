# reg-bio (F-5), the α surface: production scale is load-bearing
#
# The Elowitz–Leibler α sets the production scale of the ring. Raising α
# (plasmid copy number / RBS strength in the published system) drives the
# same fold to higher levels. Defaults (α=10) are bit-identical to history.
repressilator x -> y -> z alpha 20
frame proof {
    # tick 0 is the [5, 0, 0] init regardless of kinetics
    let s0 = repressi_state()
    assert(s0.x == 5.0 && s0.y == 0.0 && s0.z == 0.0, "ring starts at the E-L init")
    # two ticks into the fold: the α=20 ring's y-node sits at ≈3.636 where
    # the historical α=10 trajectory sits at ≈1.890, production scale is
    # load-bearing (values from the published parameterization, mirrored)
    repressi_next()
    repressi_next()
    let hi = repressi_state()
    assert(hi.y > 3.6 && hi.y < 3.7, "α=20 folds y to ≈3.64 (α=10 folds it to ≈1.89)")
}
main {
    promote("alpha-surface proofs done")
}
