# reg-bio-2 (A4): the lac operon's dual control — allostery with the RIGHT
# polarity. LacI is a repressor whose ligand (allolactose/IPTG) REDUCES its
# DNA affinity; CRP is an activator whose cofactor cAMP is required for
# binding. Induction changes the LIGAND pool, never the regulator's level —
# the mechanism is allostery, not dilution.
ligand iptg
ligand camp
regulate {
    lacI inhibits lacZ strength 0.9 threshold 0.3
    bind lacI inducer iptg k 0.2
    crp activates lacZ strength 0.9 threshold 0.4
    bind crp cofactor camp k 0.05
}
gene lacZ() { return "beta-gal" }
gene crp() { return "crp" }
frame proof {
    grn_set("lacI", 1.0)
    grn_set("crp", 1.0)
    # no ligands: the repressor sits on the operator, the cofactor is absent
    assert(lacZ() == null, "no inducer, no cAMP: repressed AND unactivated")
    # add IPTG: the repressor leaves the DNA — its LEVEL is unchanged
    ligand_set("iptg", 0.9)
    assert(abs(grn_get("lacI") - 1.0) < 1e-12, "the repressor's LEVEL never changed (allostery, not dilution)")
    assert(lacZ() == null, "IPTG alone: repression relieved but CAP-cAMP still off (glucose high)")
    # add cAMP: the classic low-glucose + inducer expressing state
    ligand_set("camp", 0.9)
    assert(lacZ() == "beta-gal", "IPTG + cAMP: the lac operon expresses")
    assert(grn_get("crp") == 1.0, "CRP level unchanged throughout (cofactor modulates affinity)")
    # polarity mirror: remove IPTG again — repression snaps back
    ligand_set("iptg", 0.0)
    assert(lacZ() == null, "inducer removed: the repressor returns to the DNA")
}
main {
    grn_set("lacI", 1.0)
    grn_set("crp", 1.0)
    promote("no-ligand: {lacZ()}")
    ligand_set("iptg", 0.9)
    promote("iptg-only: {lacZ()}")
    ligand_set("camp", 0.9)
    promote("iptg+camp: {lacZ()}")
    ligand_set("iptg", 0.0)
    promote("iptg-removed: {lacZ()}")
}
