# rt_p15b, W007: the chain exposed on a rescue binding stays contained,
# printing it leaks no host state (frames are gene names + in-file lines only).
gene probe() {
    raise overflow, "sandbox-probe"
}
gene trigger() {
    return probe()
}
stress {
    let v = trigger()
} rescue (e) {
    for f in e.chain {
        print("frame: {f.gene}@{f.line}")
    }
    print("kind: {e.kind}")
}
