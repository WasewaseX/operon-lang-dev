# sec-r5 F-12: non-scalar map keys miss the hash memo and linear-scan
# deep_eq per upsert — quadratic CPU that burned zero fuel (25k inserts
# was a live hang). Bounded scan + step charge: caught overflow. Same
# monotonic-ceiling semantics as p11a: top-level containment.
gene main() {
    let m = {};
    for i in range(25000) {
        m[[i, i + 1, i + 2, i + 3, i + 4, i + 5, i + 6, i + 7, i + 8, i + 9]] = i;
    }
    print("p11g-unreachable");
}
