# T2d / A11 (reg-r2) — repressilator dynamics (SPEC §11)
# repressi_state() integrates the discrete Elowitz–Leibler ring:
#   dA/dt = alpha / (1 + R^4) − gamma*A,  20 Euler substeps of dt=0.05 per
#   ring tick (alpha=10, gamma=1), node j repressed by node (j+n−1)%n.
# The oscillation is EMERGENT from mutual repression — no node is driven
# on a schedule. Pre-A11 cores return the hardcoded 0.5^t drive schedule
# (peaks of exactly 1.0, no repression), so the amplitude and lag
# assertions below FAIL there (verified).
repressilator p -> q -> r
frame proof {
    # warmup: ring settles into its limit cycle
    repressi_next()
    repressi_next()
    repressi_next()
    # state is a pure function of the tick count — same tick, same levels
    let s1 = repressi_state()
    let s2 = repressi_state()
    assert(s1.p == s2.p and s1.q == s2.q, "stateless fold: deterministic")
    # collect a 12-tick window of p and of r (p's repressor)
    let ph = []
    let rh = []
    let i = 0
    while i < 12 {
        repressi_next()
        let st = repressi_state()
        push(ph, st.p)
        push(rh, st.r)
        i += 1
    }
    # amplitude: an oscillator, not a latch
    let mx = ph[0]
    let mn = ph[0]
    let k = 1
    while k < 12 {
        if ph[k] > mx { mx = ph[k] }
        if ph[k] < mn { mn = ph[k] }
        k += 1
    }
    assert(mx > 5.0, "p swings high (emergent amplitude)")
    assert(mn < 0.5, "p swings low (emergent amplitude)")
    # sustained oscillation: p exceeds 5.0 at least twice in the window
    let highs = 0
    let k = 0
    while k < 12 {
        if ph[k] > 5.0 { highs += 1 }
        k += 1
    }
    assert(highs >= 2, "oscillation sustains: repeated high phases")
    # mutual repression with one tick of production lag: whenever r is
    # near its peak, p is driven low on the NEXT tick
    let k = 0
    while k < 11 {
        if rh[k] > 6.0 {
            assert(ph[k + 1] < 2.0, "repressor peak drives target low one tick later")
        }
        k += 1
    }
    # desynchronization: the three nodes are never in phase
    let s3 = repressi_state()
    assert(s3.p != s3.q and s3.q != s3.r, "nodes desynchronized (emergent phases)")
}
main {
    repressi_next()
    repressi_next()
    repressi_next()
    let s = repressi_state()
    promote("ring at tick 3: {floor(s.p)} / {floor(s.q)} / {floor(s.r)}")
}
