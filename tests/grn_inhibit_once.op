# reg-r3 (re-audit) — inhibition applies ONCE per fire, post-activation
# (SPEC §11). This program catches the exact Rust↔oracle divergence the
# loop-2 audit found: a pre-charged target under a non-threshold inhibitor
# yielded 0.1 in the Rust core but 0.0 in the old per-wave oracle mirror.
# With strength 0.9 and post-activation target 1.0: 1.0 − 0.9 = 0.1 once —
# per-wave subtraction would have driven it to 0.0.
regulate {
    d activates d strength 1.0
    c inhibits d strength 0.9
}
frame proof {
    # pre-charge d to 1.0 via a self-edge pulse, then inhibit
    let lv = grn_fire("d")
    assert(lv.d == 1.0, "target pre-charged")
    # fire the inhibitor: d drops by c's post-activation level × strength
    let lv2 = grn_fire("c")
    assert(lv2.c == 1.0, "inhibitor pulsed")
    # once-per-fire: exactly one subtraction of 0.9 from 1.0
    assert(grn_get("d") > 0.0, "inhibition applied once — target survives")
    assert(grn_get("d") < 0.2, "inhibition is real (0.1, not 1.0)")
}
main {
    grn_set("d", 1.0)
    grn_fire("c")
    promote("inhibited target: {grn_get('d')}")
}
