gene m210_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m210_f0([40, 4, 8, 19]) {

    case Ok(list) {

        print("m210-f0:", list.join("/"))

    }

    case Err(m) {

        print("m210-f0:", "e:", m)

    }

}

