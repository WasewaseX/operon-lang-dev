gene m096_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m096_f0([51, 24, 52, 23, 7, 5, 17, 47]) {

    case Ok(list) {

        print("m096-f0:", list.join("/"))

    }

    case Err(m) {

        print("m096-f0:", "e:", m)

    }

}

