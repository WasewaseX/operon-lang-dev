gene m024_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m024_f0([39, 55, 40, 3, 29, 44]) {

    case Ok(list) {

        print("m024-f0:", list.join("/"))

    }

    case Err(m) {

        print("m024-f0:", "e:", m)

    }

}

