gene m154_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m154-b0:", m154_b0({splicer: 74, cell: 99, vector: 54})?!)

