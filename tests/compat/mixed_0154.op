gene m154_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m154_f0([52, 12, 39, 14]) {

    case Ok(list) {

        print("m154-f0:", list.join("/"))

    }

    case Err(m) {

        print("m154-f0:", "e:", m)

    }

}

