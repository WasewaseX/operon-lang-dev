gene m164_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m164-b0:", m164_b0({ribose: 58, splicer: 16, exon: 68})?!)

