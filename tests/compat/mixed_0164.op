gene m164_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m164_f0([56, 45, 16, 17, 11, 40]) {

    case Ok(list) {

        print("m164-f0:", list.join("/"))

    }

    case Err(m) {

        print("m164-f0:", "e:", m)

    }

}

