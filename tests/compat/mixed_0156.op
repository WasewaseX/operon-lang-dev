gene m156_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m156_f0([13, 33, 54, 14, 13, 59, 47, 25]) {

    case Ok(list) {

        print("m156-f0:", list.join("/"))

    }

    case Err(m) {

        print("m156-f0:", "e:", m)

    }

}

