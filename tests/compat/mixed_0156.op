# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=156 tag=m156

gene m156_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m156-b0:", m156_b0({splicer: 63, exon: 76, gene: 54})?!)

