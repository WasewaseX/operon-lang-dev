gene m133_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m133_f0([55, 6, 16, 51, 47]) {

    case Ok(list) {

        print("m133-f0:", list.join("/"))

    }

    case Err(m) {

        print("m133-f0:", "e:", m)

    }

}

