gene m252_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m252-b0:", m252_b0({marker: 41, vector: 82, enzyme: 33})?!)

