gene m252_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m252_f0([27, 23, 29, 46, 21, 13, 34, 56]) {

    case Ok(list) {

        print("m252-f0:", list.join("/"))

    }

    case Err(m) {

        print("m252-f0:", "e:", m)

    }

}

