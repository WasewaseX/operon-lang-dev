gene m184_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m184_f0([28, 31, 39, 19, 6, 11, 31]) {

    case Ok(list) {

        print("m184-f0:", list.join("/"))

    }

    case Err(m) {

        print("m184-f0:", "e:", m)

    }

}

