gene m102_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m102_f0([45, 34, 36, 53, 41]) {

    case Ok(list) {

        print("m102-f0:", list.join("/"))

    }

    case Err(m) {

        print("m102-f0:", "e:", m)

    }

}

