gene m102_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m102-b0:", m102_b0({gene: 74, marker: 45, cell: 46})?!)

