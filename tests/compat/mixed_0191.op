# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=191 tag=m191

gene m191_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m191-b0:", m191_b0({enzyme: 17, marker: 81, cell: 54})?!)

