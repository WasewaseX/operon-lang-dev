gene m191_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m191_f0([17, 41, 60, 55, 33]) {

    case Ok(list) {

        print("m191-f0:", list.join("/"))

    }

    case Err(m) {

        print("m191-f0:", "e:", m)

    }

}

