gene m075_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m075_f0([50, 48, 54, 6, 41, 20]) {

    case Ok(list) {

        print("m075-f0:", list.join("/"))

    }

    case Err(m) {

        print("m075-f0:", "e:", m)

    }

}

