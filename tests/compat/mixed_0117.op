gene m117_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m117_f0([20, 12, 40, 36]) {

    case Ok(list) {

        print("m117-f0:", list.join("/"))

    }

    case Err(m) {

        print("m117-f0:", "e:", m)

    }

}

