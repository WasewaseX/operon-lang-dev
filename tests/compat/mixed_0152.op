gene m152_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m152_f0([12, 40, 24, 27, 34, 20, 40]) {

    case Ok(list) {

        print("m152-f0:", list.join("/"))

    }

    case Err(m) {

        print("m152-f0:", "e:", m)

    }

}

