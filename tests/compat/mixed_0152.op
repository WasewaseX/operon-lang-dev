# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=152 tag=m152

gene m152_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m152-b0:", m152_b0({vector: 52, ribose: 2, splicer: 53})?!)

