# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=151 tag=m151

gene m151_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m151-b0:", m151_b0({plasmid: 57, cell: 73, codon: 73})?!)

gene m151_b1(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m151-b1:", m151_b1({cell: 50, plasmid: 52, enzyme: 85})?!)

gene m151_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m151_f0([25, 18, 7, 23]) {

    case Ok(list) {

        print("m151-f0:", list.join("/"))

    }

    case Err(m) {

        print("m151-f0:", "e:", m)

    }

}

