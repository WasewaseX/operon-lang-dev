# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=183 tag=m183

gene m183_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m183-b0:", m183_b0({ligase: 91, exon: 10, ribose: 74})?!)

