gene m183_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m183_f0([4, 15, 53, 49, 49]) {

    case Ok(list) {

        print("m183-f0:", list.join("/"))

    }

    case Err(m) {

        print("m183-f0:", "e:", m)

    }

}

