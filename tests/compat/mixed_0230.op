gene m230_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m230_f0([43, 43, 53, 52, 13, 41, 36, 48]) {

    case Ok(list) {

        print("m230-f0:", list.join("/"))

    }

    case Err(m) {

        print("m230-f0:", "e:", m)

    }

}

