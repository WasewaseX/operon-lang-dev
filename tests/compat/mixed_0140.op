gene m140_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m140_f0([5, 21, 37, 14, 2]) {

    case Ok(list) {

        print("m140-f0:", list.join("/"))

    }

    case Err(m) {

        print("m140-f0:", "e:", m)

    }

}

