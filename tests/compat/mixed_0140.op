# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=140 tag=m140

gene m140_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m140-b0:", m140_b0({ligase: 74, ribose: 29, helix: 35})?!)

