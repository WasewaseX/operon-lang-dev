gene m220_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m220_f0([33, 5, 37, 13]) {

    case Ok(list) {

        print("m220-f0:", list.join("/"))

    }

    case Err(m) {

        print("m220-f0:", "e:", m)

    }

}

