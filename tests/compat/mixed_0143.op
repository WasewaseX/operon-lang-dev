# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=143 tag=m143

gene m143_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m143-b0:", m143_b0({splicer: 84, helix: 67, exon: 22})?!)

gene m143_b1(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m143-b1:", m143_b1({vector: 73, gene: 80, enzyme: 99})?!)

gene m143_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m143_f0([21, 56, 32, 36, 16]) {

    case Ok(list) {

        print("m143-f0:", list.join("/"))

    }

    case Err(m) {

        print("m143-f0:", "e:", m)

    }

}

