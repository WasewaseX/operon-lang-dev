# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=234 tag=m234

gene m234_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m234-b0:", m234_b0({ribose: 66, enzyme: 5, splicer: 59})?!)

