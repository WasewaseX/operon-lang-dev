gene m234_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m234_f0([55, 48, 53, 19, 7, 46, 27]) {

    case Ok(list) {

        print("m234-f0:", list.join("/"))

    }

    case Err(m) {

        print("m234-f0:", "e:", m)

    }

}

