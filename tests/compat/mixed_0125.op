# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=125 tag=m125

gene m125_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m125-b0:", m125_b0({splicer: 39, exon: 92, marker: 20})?!)

