gene m125_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m125_f0([23, 38, 44, 47, 34, 57, 53]) {

    case Ok(list) {

        print("m125-f0:", list.join("/"))

    }

    case Err(m) {

        print("m125-f0:", "e:", m)

    }

}

