gene m000_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m000_f0([60, 6, 12, 38]) {

    case Ok(list) {

        print("m000-f0:", list.join("/"))

    }

    case Err(m) {

        print("m000-f0:", "e:", m)

    }

}

