gene m048_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m048_f0([53, 32, 47, 49, 46]) {

    case Ok(list) {

        print("m048-f0:", list.join("/"))

    }

    case Err(m) {

        print("m048-f0:", "e:", m)

    }

}

