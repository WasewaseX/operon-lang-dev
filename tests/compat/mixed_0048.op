# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20260930 idx=48 tag=m048

gene m048_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m048-b0:", m048_b0({exon: 15, plasmid: 87, splicer: 63})?!)

