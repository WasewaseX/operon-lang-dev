gene m232_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m232_f0([19, 1, 52, 45]) {

    case Ok(list) {

        print("m232-f0:", list.join("/"))

    }

    case Err(m) {

        print("m232-f0:", "e:", m)

    }

}

