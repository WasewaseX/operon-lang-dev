gene m080_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m080_f0([3, 20, 2, 9, 46, 35, 15]) {

    case Ok(list) {

        print("m080-f0:", list.join("/"))

    }

    case Err(m) {

        print("m080-f0:", "e:", m)

    }

}

