let m199_cl0 = gene (x) {

    return gene (y) {

        return x * 100 + y

    }

}

print("m199-cc0:", m199_cl0(9)(3), m199_cl0(3)(9))

let m199_cl1 = gene (x) {

    return gene (y) {

        return x * 100 + y

    }

}

print("m199-cc1:", m199_cl1(5)(13), m199_cl1(13)(5))

let m199_data0 = some([some("codon"), none(), some(8)])

match m199_data0 {

    case Some([Some(s), none(), Some(n)]) {

        print("m199-x0:", s, n, s.len())

    }

    case _ {

        print("m199-x0:", "shape-miss")

    }

}

let m199_data1 = some([some("enzyme"), none(), some(4)])

match m199_data1 {

    case Some([Some(s), none(), Some(n)]) {

