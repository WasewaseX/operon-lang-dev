print("m199-b2:", m199_b2({exon: 13, codon: 26, ribose: 41})?!)

gene m199_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m199_f0([26, 23, 24, 20, 30, 3]) {

    case Ok(list) {

        print("m199-f0:", list.join("/"))

    }

    case Err(m) {

        print("m199-f0:", "e:", m)

    }

}

