# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=199 tag=m199

gene m199_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m199-b0:", m199_b0({splicer: 30, exon: 19, plasmid: 41})?!)

