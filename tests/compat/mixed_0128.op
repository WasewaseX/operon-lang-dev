print("m128-b2:", m128_b2({helix: 14, exon: 7, marker: 51})?!)

gene m128_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m128_f0([42, 56, 14, 11, 43, 26, 9, 28]) {

    case Ok(list) {

        print("m128-f0:", list.join("/"))

    }

    case Err(m) {

        print("m128-f0:", "e:", m)

    }

}

