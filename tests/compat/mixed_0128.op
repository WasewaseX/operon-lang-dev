# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=128 tag=m128

gene m128_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m128-b0:", m128_b0({cell: 54, helix: 67, gene: 26})?!)

