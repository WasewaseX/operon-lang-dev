gene m114_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m114_f0([57, 54, 9, 5, 43, 2, 6]) {

    case Ok(list) {

        print("m114-f0:", list.join("/"))

    }

    case Err(m) {

        print("m114-f0:", "e:", m)

    }

}

