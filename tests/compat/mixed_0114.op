# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=114 tag=m114

gene m114_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m114-b0:", m114_b0({exon: 19, helix: 80, gene: 52})?!)

