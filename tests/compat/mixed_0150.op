# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=150 tag=m150

gene m150_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m150-b0:", m150_b0({plasmid: 50, ligase: 88, marker: 66})?!)

gene m150_b1(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m150-b1:", m150_b1({cell: 31, plasmid: 44, marker: 6})?!)

gene m150_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m150_f0([58, 55, 46, 31, 28, 25, 27, 18]) {

    case Ok(list) {

        print("m150-f0:", list.join("/"))

    }

    case Err(m) {

        print("m150-f0:", "e:", m)

    }

}

