# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=170 tag=m170

gene m170_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m170-b0:", m170_b0({splicer: 5, enzyme: 7, vector: 1})?!)

