gene m170_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m170_f0([38, 55, 55, 22, 40, 39, 31, 60]) {

    case Ok(list) {

        print("m170-f0:", list.join("/"))

    }

    case Err(m) {

        print("m170-f0:", "e:", m)

    }

}

