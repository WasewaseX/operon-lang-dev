# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=144 tag=m144

gene m144_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m144-b0:", m144_b0({codon: 86, marker: 1, exon: 65})?!)

gene m144_b1(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m144-b1:", m144_b1({splicer: 90, plasmid: 78, ribose: 69})?!)

gene m144_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m144_f0([48, 8, 24, 26, 12, 29, 27]) {

    case Ok(list) {

        print("m144-f0:", list.join("/"))

    }

    case Err(m) {

        print("m144-f0:", "e:", m)

    }

}

