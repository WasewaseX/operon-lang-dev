gene m095_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m095_f0([32, 18, 9, 47, 25, 39, 6]) {

    case Ok(list) {

        print("m095-f0:", list.join("/"))

    }

    case Err(m) {

        print("m095-f0:", "e:", m)

    }

}

