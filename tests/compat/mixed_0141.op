gene m141_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m141-b0:", m141_b0({marker: 6, enzyme: 13, exon: 93})?!)

