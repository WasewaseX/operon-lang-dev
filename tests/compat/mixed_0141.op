gene m141_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m141_f0([20, 39, 12, 8, 21, 41]) {

    case Ok(list) {

        print("m141-f0:", list.join("/"))

    }

    case Err(m) {

        print("m141-f0:", "e:", m)

    }

}

