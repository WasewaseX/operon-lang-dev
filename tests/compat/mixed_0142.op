gene m142_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m142_f0([41, 13, 60, 58, 9, 33, 28]) {

    case Ok(list) {

        print("m142-f0:", list.join("/"))

    }

    case Err(m) {

        print("m142-f0:", "e:", m)

    }

}

