gene m163_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m163_f0([46, 28, 28, 29, 20, 38]) {

    case Ok(list) {

        print("m163-f0:", list.join("/"))

    }

    case Err(m) {

        print("m163-f0:", "e:", m)

    }

}

