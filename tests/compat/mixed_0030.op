gene m030_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m030_f0([42, 44, 32, 54]) {

    case Ok(list) {

        print("m030-f0:", list.join("/"))

    }

    case Err(m) {

        print("m030-f0:", "e:", m)

    }

}

