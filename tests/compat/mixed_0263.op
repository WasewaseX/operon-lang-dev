gene m263_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m263_f0([54, 49, 8, 58, 51, 35, 15, 48]) {

    case Ok(list) {

        print("m263-f0:", list.join("/"))

    }

    case Err(m) {

        print("m263-f0:", "e:", m)

    }

}

