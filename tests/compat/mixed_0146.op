gene m146_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m146_f0([6, 12, 23, 8, 47, 32, 38, 54]) {

    case Ok(list) {

        print("m146-f0:", list.join("/"))

    }

    case Err(m) {

        print("m146-f0:", "e:", m)

    }

}

