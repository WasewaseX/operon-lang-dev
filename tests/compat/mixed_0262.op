# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=262 tag=m262

gene m262_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m262-b0:", m262_b0({exon: 17, plasmid: 21, ribose: 47})?!)

