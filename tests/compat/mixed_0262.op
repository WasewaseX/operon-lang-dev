gene m262_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m262_f0([24, 18, 25, 43, 23]) {

    case Ok(list) {

        print("m262-f0:", list.join("/"))

    }

    case Err(m) {

        print("m262-f0:", "e:", m)

    }

}

