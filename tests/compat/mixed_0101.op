# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=101 tag=m101

gene m101_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m101-b0:", m101_b0({enzyme: 67, plasmid: 53, ribose: 57})?!)

