gene m101_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m101_f0([18, 6, 30, 22]) {

    case Ok(list) {

        print("m101-f0:", list.join("/"))

    }

    case Err(m) {

        print("m101-f0:", "e:", m)

    }

}

