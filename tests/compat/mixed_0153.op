gene m153_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m153_f0([27, 1, 15, 12, 6]) {

    case Ok(list) {

        print("m153-f0:", list.join("/"))

    }

    case Err(m) {

        print("m153-f0:", "e:", m)

    }

}

