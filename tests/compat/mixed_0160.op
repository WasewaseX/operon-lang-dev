# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=160 tag=m160

gene m160_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m160-b0:", m160_b0({marker: 38, vector: 46, plasmid: 66})?!)

gene m160_b1(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m160-b1:", m160_b1({vector: 38, codon: 90, ligase: 24})?!)

gene m160_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m160_f0([57, 31, 6, 55, 58]) {

    case Ok(list) {

        print("m160-f0:", list.join("/"))

    }

    case Err(m) {

        print("m160-f0:", "e:", m)

    }

}

gene m160_f1(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m160_f1([15, 54, 55, 5, 54, 12, 17, 58]) {

    case Ok(list) {

        print("m160-f1:", list.join("/"))

    }

    case Err(m) {

        print("m160-f1:", "e:", m)

    }

}

let m160_cl0 = gene (x) {

    return gene (y) {

        return x * 100 + y

    }

}

print("m160-cc0:", m160_cl0(7)(3), m160_cl0(3)(7))

let m160_cl1 = gene (x) {

    return gene (y) {

        return x * 100 + y

    }

}

print("m160-cc1:", m160_cl1(13)(6), m160_cl1(6)(13))

let m160_data0 = some([some("exon"), none(), some(4)])

match m160_data0 {

    case Some([Some(s), none(), Some(n)]) {

        print("m160-x0:", s, n, s.len())

    }

    case _ {

        print("m160-x0:", "shape-miss")

    }

}

let m160_data1 = some([some("marker"), none(), some(2)])

match m160_data1 {

    case Some([Some(s), none(), Some(n)]) {

        print("m160-x1:", s, n, s.len())

    }

