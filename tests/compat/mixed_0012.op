gene m012_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m012_f0([25, 10, 55, 33]) {

    case Ok(list) {

        print("m012-f0:", list.join("/"))

    }

    case Err(m) {

        print("m012-f0:", "e:", m)

    }

}

