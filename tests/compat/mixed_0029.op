gene m029_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m029_f0([1, 3, 5, 12, 34, 19]) {

    case Ok(list) {

        print("m029-f0:", list.join("/"))

    }

    case Err(m) {

        print("m029-f0:", "e:", m)

    }

}

