gene m171_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m171_f0([31, 50, 47, 27, 42, 16, 53]) {

    case Ok(list) {

        print("m171-f0:", list.join("/"))

    }

    case Err(m) {

        print("m171-f0:", "e:", m)

    }

}

