gene m161_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m161_f0([42, 43, 13, 5, 32]) {

    case Ok(list) {

        print("m161-f0:", list.join("/"))

    }

    case Err(m) {

        print("m161-f0:", "e:", m)

    }

}

