let m255_cl0 = gene (x) {

    return gene (y) {

        return x * 100 + y

    }

}

print("m255-cc0:", m255_cl0(20)(17), m255_cl0(17)(20))

let m255_cl1 = gene (x) {

    return gene (y) {

        return x * 100 + y

    }

}

print("m255-cc1:", m255_cl1(8)(15), m255_cl1(15)(8))

let m255_data0 = some([some("ribose"), none(), some(7)])

match m255_data0 {

    case Some([Some(s), none(), Some(n)]) {

        print("m255-x0:", s, n, s.len())

    }

    case _ {

        print("m255-x0:", "shape-miss")

    }

}

let m255_data1 = some([some("splicer"), none(), some(2)])

