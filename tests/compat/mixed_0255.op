# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=255 tag=m255

gene m255_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m255-b0:", m255_b0({plasmid: 76, codon: 99, ligase: 60})?!)

