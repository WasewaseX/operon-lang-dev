print("m255-b2:", m255_b2({helix: 24, vector: 7, cell: 13})?!)

gene m255_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m255_f0([33, 23, 27, 14]) {

    case Ok(list) {

        print("m255-f0:", list.join("/"))

    }

    case Err(m) {

        print("m255-f0:", "e:", m)

    }

}

