gene m225_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m225-b0:", m225_b0({helix: 15, codon: 57, ribose: 31})?!)

