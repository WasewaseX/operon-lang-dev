gene m225_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m225_f0([2, 36, 45, 16, 56, 50]) {

    case Ok(list) {

        print("m225-f0:", list.join("/"))

    }

    case Err(m) {

        print("m225-f0:", "e:", m)

    }

}

