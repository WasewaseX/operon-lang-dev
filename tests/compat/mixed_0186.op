gene m186_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m186-b0:", m186_b0({marker: 60, plasmid: 95, ribose: 68})?!)

