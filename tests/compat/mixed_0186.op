gene m186_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m186_f0([19, 7, 15, 46]) {

    case Ok(list) {

        print("m186-f0:", list.join("/"))

    }

    case Err(m) {

        print("m186-f0:", "e:", m)

    }

}

