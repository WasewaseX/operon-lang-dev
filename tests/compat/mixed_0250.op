# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=250 tag=m250

gene m250_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m250-b0:", m250_b0({plasmid: 98, exon: 94, vector: 92})?!)

gene m250_b1(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m250-b1:", m250_b1({helix: 38, vector: 85, ligase: 60})?!)

gene m250_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m250_f0([36, 37, 37, 32, 46, 25]) {

    case Ok(list) {

        print("m250-f0:", list.join("/"))

    }

    case Err(m) {

        print("m250-f0:", "e:", m)

    }

}

