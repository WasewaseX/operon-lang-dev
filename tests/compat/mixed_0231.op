gene m231_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m231_f0([55, 37, 5, 9]) {

    case Ok(list) {

        print("m231-f0:", list.join("/"))

    }

    case Err(m) {

        print("m231-f0:", "e:", m)

    }

}

