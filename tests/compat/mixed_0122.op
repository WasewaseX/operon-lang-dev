gene m122_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m122_f0([3, 14, 23, 27, 1, 45, 40, 16]) {

    case Ok(list) {

        print("m122-f0:", list.join("/"))

    }

    case Err(m) {

        print("m122-f0:", "e:", m)

    }

}

