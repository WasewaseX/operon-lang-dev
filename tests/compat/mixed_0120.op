# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=120 tag=m120

gene m120_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m120-b0:", m120_b0({cell: 4, codon: 83, plasmid: 28})?!)

gene m120_b1(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m120-b1:", m120_b1({gene: 94, cell: 17, codon: 97})?!)

gene m120_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m120_f0([52, 17, 35, 49]) {

    case Ok(list) {

        print("m120-f0:", list.join("/"))

    }

    case Err(m) {

        print("m120-f0:", "e:", m)

    }

}

