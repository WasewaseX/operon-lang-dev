gene m147_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m147_f0([55, 55, 39, 7, 60]) {

    case Ok(list) {

        print("m147-f0:", list.join("/"))

    }

    case Err(m) {

        print("m147-f0:", "e:", m)

    }

}

