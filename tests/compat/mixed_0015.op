# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20260930 idx=15 tag=m015

gene m015_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

