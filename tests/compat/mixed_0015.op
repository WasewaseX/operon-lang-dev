gene m015_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m015_f0([40, 60, 19, 53, 55, 25, 42, 27]) {

    case Ok(list) {

        print("m015-f0:", list.join("/"))

    }

    case Err(m) {

        print("m015-f0:", "e:", m)

    }

}

