gene m136_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m136_f0([8, 16, 29, 53, 6, 17, 11]) {

    case Ok(list) {

        print("m136-f0:", list.join("/"))

    }

    case Err(m) {

        print("m136-f0:", "e:", m)

    }

}

