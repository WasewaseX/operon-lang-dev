# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=126 tag=m126

gene m126_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m126-b0:", m126_b0({exon: 41, splicer: 95, plasmid: 14})?!)

