print("m126-b1:", m126_b1({codon: 70, exon: 58, enzyme: 72})?!)

gene m126_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m126_f0([60, 21, 2, 4, 3, 23, 11, 34]) {

    case Ok(list) {

        print("m126-f0:", list.join("/"))

    }

    case Err(m) {

        print("m126-f0:", "e:", m)

    }

}

