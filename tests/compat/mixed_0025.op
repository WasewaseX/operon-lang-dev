gene m025_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m025_f0([59, 29, 30, 4, 34, 21, 13]) {

    case Ok(list) {

        print("m025-f0:", list.join("/"))

    }

    case Err(m) {

        print("m025-f0:", "e:", m)

    }

}

