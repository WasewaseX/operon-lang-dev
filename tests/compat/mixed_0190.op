# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=190 tag=m190

gene m190_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m190-b0:", m190_b0({codon: 54, ribose: 48, plasmid: 88})?!)

