gene m190_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m190_f0([33, 18, 29, 22, 51, 12, 2, 54]) {

    case Ok(list) {

        print("m190-f0:", list.join("/"))

    }

    case Err(m) {

        print("m190-f0:", "e:", m)

    }

}

