    }

}

let m256_cl0 = gene (x) {

    return gene (y) {

        return x * 100 + y

    }

}

print("m256-cc0:", m256_cl0(3)(8), m256_cl0(8)(3))

let m256_cl1 = gene (x) {

    return gene (y) {

        return x * 100 + y

    }

}

print("m256-cc1:", m256_cl1(17)(17), m256_cl1(17)(17))

let m256_data0 = some([some("ligase"), none(), some(1)])

match m256_data0 {

    case Some([Some(s), none(), Some(n)]) {

        print("m256-x0:", s, n, s.len())

    }

    case _ {

        print("m256-x0:", "shape-miss")

    }

}

