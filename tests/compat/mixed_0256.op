# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=256 tag=m256

gene m256_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m256-b0:", m256_b0({cell: 93, codon: 83, gene: 10})?!)

gene m256_b1(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m256-b1:", m256_b1({ligase: 41, plasmid: 11, codon: 29})?!)

gene m256_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m256_f0([22, 20, 15, 43]) {

    case Ok(list) {

        print("m256-f0:", list.join("/"))

    }

    case Err(m) {

        print("m256-f0:", "e:", m)

    }

}

