gene m257_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m257_f0([55, 28, 44, 3, 24, 21, 1]) {

    case Ok(list) {

        print("m257-f0:", list.join("/"))

    }

    case Err(m) {

        print("m257-f0:", "e:", m)

    }

}

