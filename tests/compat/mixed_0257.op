# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=257 tag=m257

gene m257_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m257-b0:", m257_b0({marker: 35, cell: 73, helix: 6})?!)

