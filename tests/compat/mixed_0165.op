gene m165_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m165_f0([3, 44, 32, 31, 51, 12, 33]) {

    case Ok(list) {

        print("m165-f0:", list.join("/"))

    }

    case Err(m) {

        print("m165-f0:", "e:", m)

    }

}

