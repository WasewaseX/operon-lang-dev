gene m107_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m107_f0([17, 32, 20, 11, 6, 38]) {

    case Ok(list) {

        print("m107-f0:", list.join("/"))

    }

    case Err(m) {

        print("m107-f0:", "e:", m)

    }

}

