gene m192_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m192_f0([58, 53, 57, 25, 9, 18, 5]) {

    case Ok(list) {

        print("m192-f0:", list.join("/"))

    }

    case Err(m) {

        print("m192-f0:", "e:", m)

    }

}

