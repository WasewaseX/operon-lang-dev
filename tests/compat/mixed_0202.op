gene m202_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m202_f0([43, 7, 22, 27, 44, 1, 44]) {

    case Ok(list) {

        print("m202-f0:", list.join("/"))

    }

    case Err(m) {

        print("m202-f0:", "e:", m)

    }

}

