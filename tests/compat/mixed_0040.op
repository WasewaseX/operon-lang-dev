gene m040_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m040_f0([16, 15, 16, 42]) {

    case Ok(list) {

        print("m040-f0:", list.join("/"))

    }

    case Err(m) {

        print("m040-f0:", "e:", m)

    }

}

