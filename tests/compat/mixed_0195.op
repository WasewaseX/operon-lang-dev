gene m195_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m195_f0([20, 38, 3, 47, 47, 49, 22]) {

    case Ok(list) {

        print("m195-f0:", list.join("/"))

    }

    case Err(m) {

        print("m195-f0:", "e:", m)

    }

}

