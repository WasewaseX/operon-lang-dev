gene m050_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m050_f0([35, 35, 53, 5]) {

    case Ok(list) {

        print("m050-f0:", list.join("/"))

    }

    case Err(m) {

        print("m050-f0:", "e:", m)

    }

}

