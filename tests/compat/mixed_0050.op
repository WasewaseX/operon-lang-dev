gene m050_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m050-b0:", m050_b0({gene: 81, cell: 2, vector: 10})?!)

