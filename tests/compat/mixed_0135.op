gene m135_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m135_f0([3, 13, 1, 49, 42]) {

    case Ok(list) {

        print("m135-f0:", list.join("/"))

    }

    case Err(m) {

        print("m135-f0:", "e:", m)

    }

}

