# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=155 tag=m155

gene m155_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m155-b0:", m155_b0({marker: 50, ribose: 58, codon: 86})?!)

gene m155_b1(m) {

