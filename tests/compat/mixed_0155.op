print("m155-b1:", m155_b1({cell: 38, exon: 82, vector: 28})?!)

gene m155_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m155_f0([37, 50, 58, 59, 23, 14, 2]) {

    case Ok(list) {

        print("m155-f0:", list.join("/"))

    }

    case Err(m) {

        print("m155-f0:", "e:", m)

    }

}

