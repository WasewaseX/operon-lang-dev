gene m111_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m111_f0([16, 1, 28, 38, 57, 29, 52, 42]) {

    case Ok(list) {

        print("m111-f0:", list.join("/"))

    }

    case Err(m) {

        print("m111-f0:", "e:", m)

    }

}

