# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=198 tag=m198

gene m198_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m198-b0:", m198_b0({ribose: 93, exon: 12, helix: 54})?!)

gene m198_b1(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m198-b1:", m198_b1({enzyme: 60, gene: 84, cell: 60})?!)

gene m198_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m198_f0([38, 46, 15, 8, 44, 42]) {

    case Ok(list) {

        print("m198-f0:", list.join("/"))

    }

    case Err(m) {

        print("m198-f0:", "e:", m)

    }

}

