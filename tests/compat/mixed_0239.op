gene m239_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m239_f0([9, 14, 16, 8, 20, 49, 43, 9]) {

    case Ok(list) {

        print("m239-f0:", list.join("/"))

    }

    case Err(m) {

        print("m239-f0:", "e:", m)

    }

}

