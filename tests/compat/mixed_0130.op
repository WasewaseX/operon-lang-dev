let m130_data0 = some([some("ribose"), none(), some(7)])

match m130_data0 {

    case Some([Some(s), none(), Some(n)]) {

        print("m130-x0:", s, n, s.len())

    }

    case _ {

        print("m130-x0:", "shape-miss")

    }

}

