# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=130 tag=m130

gene m130_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m130-b0:", m130_b0({splicer: 35, plasmid: 94, exon: 71})?!)

