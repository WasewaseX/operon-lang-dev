gene m130_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m130_f0([25, 56, 4, 54, 53, 21, 27]) {

    case Ok(list) {

        print("m130-f0:", list.join("/"))

    }

    case Err(m) {

        print("m130-f0:", "e:", m)

    }

}

