# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=254 tag=m254

gene m254_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m254-b0:", m254_b0({vector: 51, ligase: 13, plasmid: 13})?!)

