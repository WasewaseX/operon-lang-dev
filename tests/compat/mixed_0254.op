print("m254-b1:", m254_b1({gene: 59, splicer: 37, vector: 79})?!)

gene m254_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m254_f0([29, 25, 13, 48, 21, 19]) {

    case Ok(list) {

        print("m254-f0:", list.join("/"))

    }

    case Err(m) {

        print("m254-f0:", "e:", m)

    }

}

