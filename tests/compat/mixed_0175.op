# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=175 tag=m175

gene m175_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m175-b0:", m175_b0({vector: 61, plasmid: 62, exon: 79})?!)

gene m175_b1(m) {

