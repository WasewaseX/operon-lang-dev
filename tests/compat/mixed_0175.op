}

print("m175-b1:", m175_b1({enzyme: 80, splicer: 86, vector: 26})?!)

gene m175_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m175_f0([22, 57, 42, 46, 25]) {

    case Ok(list) {

        print("m175-f0:", list.join("/"))

    }

    case Err(m) {

        print("m175-f0:", "e:", m)

    }

}

