gene m085_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m085_f0([52, 9, 52, 48]) {

    case Ok(list) {

        print("m085-f0:", list.join("/"))

    }

    case Err(m) {

        print("m085-f0:", "e:", m)

    }

}

