gene m134_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m134_f0([8, 30, 35, 59, 48, 14, 31]) {

    case Ok(list) {

        print("m134-f0:", list.join("/"))

    }

    case Err(m) {

        print("m134-f0:", "e:", m)

    }

}

