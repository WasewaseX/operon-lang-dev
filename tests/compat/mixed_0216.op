gene m216_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m216-b0:", m216_b0({enzyme: 35, plasmid: 28, helix: 61})?!)

