gene m216_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m216_f0([21, 33, 16, 20, 10, 27]) {

    case Ok(list) {

        print("m216-f0:", list.join("/"))

    }

    case Err(m) {

        print("m216-f0:", "e:", m)

    }

}

