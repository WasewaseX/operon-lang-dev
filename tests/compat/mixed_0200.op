print("m200-b2:", m200_b2({vector: 65, ligase: 46, enzyme: 76})?!)

gene m200_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m200_f0([3, 43, 17, 34, 45, 22, 32, 24]) {

    case Ok(list) {

        print("m200-f0:", list.join("/"))

    }

    case Err(m) {

        print("m200-f0:", "e:", m)

    }

}

