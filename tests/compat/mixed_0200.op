# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=200 tag=m200

gene m200_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m200-b0:", m200_b0({plasmid: 67, gene: 90, exon: 83})?!)

