gene m060_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m060_f0([48, 60, 28, 25]) {

    case Ok(list) {

        print("m060-f0:", list.join("/"))

    }

    case Err(m) {

        print("m060-f0:", "e:", m)

    }

}

