gene m090_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m090_f0([6, 34, 20, 11, 49, 19, 38]) {

    case Ok(list) {

        print("m090-f0:", list.join("/"))

    }

    case Err(m) {

        print("m090-f0:", "e:", m)

    }

}

