gene m099_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m099_f0([41, 12, 16, 55, 17, 5]) {

    case Ok(list) {

        print("m099-f0:", list.join("/"))

    }

    case Err(m) {

        print("m099-f0:", "e:", m)

    }

}

