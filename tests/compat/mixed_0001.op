gene m001_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m001_f0([16, 24, 36, 27, 37, 23, 25]) {

    case Ok(list) {

        print("m001-f0:", list.join("/"))

    }

    case Err(m) {

        print("m001-f0:", "e:", m)

    }

}

