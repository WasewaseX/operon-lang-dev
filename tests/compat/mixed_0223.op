gene m223_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m223-b0:", m223_b0({marker: 34, splicer: 75, helix: 10})?!)

