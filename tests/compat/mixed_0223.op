gene m223_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m223_f0([49, 29, 56, 31, 22, 9, 21]) {

    case Ok(list) {

        print("m223-f0:", list.join("/"))

    }

    case Err(m) {

        print("m223-f0:", "e:", m)

    }

}

