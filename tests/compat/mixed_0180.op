# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=180 tag=m180

gene m180_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m180-b0:", m180_b0({exon: 82, cell: 91, gene: 17})?!)

gene m180_b1(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m180-b1:", m180_b1({enzyme: 88, marker: 24, cell: 82})?!)

gene m180_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m180_f0([2, 5, 26, 30, 22]) {

    case Ok(list) {

        print("m180-f0:", list.join("/"))

    }

    case Err(m) {

        print("m180-f0:", "e:", m)

    }

}

