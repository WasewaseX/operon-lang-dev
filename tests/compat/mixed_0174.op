gene m174_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m174-b0:", m174_b0({enzyme: 95, codon: 82, exon: 23})?!)

