gene m174_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m174_f0([17, 11, 26, 19, 40, 48, 8, 38]) {

    case Ok(list) {

        print("m174-f0:", list.join("/"))

    }

    case Err(m) {

        print("m174-f0:", "e:", m)

    }

}

