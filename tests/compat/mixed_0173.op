gene m173_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m173_f0([27, 22, 59, 34, 39]) {

    case Ok(list) {

        print("m173-f0:", list.join("/"))

    }

    case Err(m) {

        print("m173-f0:", "e:", m)

    }

}

