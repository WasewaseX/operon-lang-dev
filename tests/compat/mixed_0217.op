gene m217_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m217_f0([25, 22, 43, 9, 42]) {

    case Ok(list) {

        print("m217-f0:", list.join("/"))

    }

    case Err(m) {

        print("m217-f0:", "e:", m)

    }

}

