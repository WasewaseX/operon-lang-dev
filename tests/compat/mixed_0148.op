gene m148_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m148-b0:", m148_b0({codon: 9, ligase: 26, enzyme: 39})?!)

