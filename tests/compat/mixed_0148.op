gene m148_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m148_f0([7, 30, 57, 9, 10]) {

    case Ok(list) {

        print("m148-f0:", list.join("/"))

    }

    case Err(m) {

        print("m148-f0:", "e:", m)

    }

}

