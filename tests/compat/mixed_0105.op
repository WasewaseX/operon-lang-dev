gene m105_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m105_f0([8, 33, 8, 42, 60, 37, 28]) {

    case Ok(list) {

        print("m105-f0:", list.join("/"))

    }

    case Err(m) {

        print("m105-f0:", "e:", m)

    }

}

