# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=121 tag=m121

gene m121_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m121-b0:", m121_b0({helix: 83, ribose: 90, marker: 88})?!)

