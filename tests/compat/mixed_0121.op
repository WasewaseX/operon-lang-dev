print("m121-b1:", m121_b1({marker: 93, cell: 81, plasmid: 90})?!)

gene m121_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m121_f0([11, 9, 35, 25, 37, 26]) {

    case Ok(list) {

        print("m121-f0:", list.join("/"))

    }

    case Err(m) {

        print("m121-f0:", "e:", m)

    }

}

