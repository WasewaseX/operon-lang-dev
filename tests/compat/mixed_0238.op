# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=238 tag=m238

gene m238_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

