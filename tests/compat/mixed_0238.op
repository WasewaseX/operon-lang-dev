gene m238_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m238_f0([25, 14, 8, 34]) {

    case Ok(list) {

        print("m238-f0:", list.join("/"))

    }

    case Err(m) {

        print("m238-f0:", "e:", m)

    }

}

