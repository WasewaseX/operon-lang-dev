# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=185 tag=m185

gene m185_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m185-b0:", m185_b0({cell: 12, splicer: 40, ligase: 29})?!)

