gene m185_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m185_f0([33, 27, 32, 51, 46]) {

    case Ok(list) {

        print("m185-f0:", list.join("/"))

    }

    case Err(m) {

        print("m185-f0:", "e:", m)

    }

}

