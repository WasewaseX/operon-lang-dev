# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=145 tag=m145

gene m145_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m145-b0:", m145_b0({splicer: 71, plasmid: 37, vector: 33})?!)

