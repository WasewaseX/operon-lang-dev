gene m145_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m145_f0([26, 34, 48, 54]) {

    case Ok(list) {

        print("m145-f0:", list.join("/"))

    }

    case Err(m) {

        print("m145-f0:", "e:", m)

    }

}

