gene m159_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m159_f0([20, 51, 60, 1, 17, 51, 11]) {

    case Ok(list) {

        print("m159-f0:", list.join("/"))

    }

    case Err(m) {

        print("m159-f0:", "e:", m)

    }

}

