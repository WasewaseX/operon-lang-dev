gene m039_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m039_f0([34, 17, 26, 45, 54, 9]) {

    case Ok(list) {

        print("m039-f0:", list.join("/"))

    }

    case Err(m) {

        print("m039-f0:", "e:", m)

    }

}

