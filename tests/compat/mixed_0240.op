gene m240_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m240_f0([1, 18, 17, 46, 30]) {

    case Ok(list) {

        print("m240-f0:", list.join("/"))

    }

    case Err(m) {

        print("m240-f0:", "e:", m)

    }

}

