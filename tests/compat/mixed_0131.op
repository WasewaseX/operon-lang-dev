gene m131_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m131-b0:", m131_b0({gene: 58, cell: 16, ligase: 23})?!)

