gene m131_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m131_f0([5, 45, 56, 4, 22]) {

    case Ok(list) {

        print("m131-f0:", list.join("/"))

    }

    case Err(m) {

        print("m131-f0:", "e:", m)

    }

}

