gene m260_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m260_f0([57, 16, 37, 18]) {

    case Ok(list) {

        print("m260-f0:", list.join("/"))

    }

    case Err(m) {

        print("m260-f0:", "e:", m)

    }

}

