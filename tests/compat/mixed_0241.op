gene m241_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m241_f0([20, 33, 58, 6, 42]) {

    case Ok(list) {

        print("m241-f0:", list.join("/"))

    }

    case Err(m) {

        print("m241-f0:", "e:", m)

    }

}

