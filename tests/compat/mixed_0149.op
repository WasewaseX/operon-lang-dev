# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=149 tag=m149

gene m149_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m149-b0:", m149_b0({plasmid: 58, splicer: 23, codon: 6})?!)

