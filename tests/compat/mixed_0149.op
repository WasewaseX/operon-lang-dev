gene m149_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m149_f0([29, 14, 24, 24, 53]) {

    case Ok(list) {

        print("m149-f0:", list.join("/"))

    }

    case Err(m) {

        print("m149-f0:", "e:", m)

    }

}

