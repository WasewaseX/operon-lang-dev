gene m118_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m118_f0([22, 40, 36, 38, 59, 7]) {

    case Ok(list) {

        print("m118-f0:", list.join("/"))

    }

    case Err(m) {

        print("m118-f0:", "e:", m)

    }

}

