print("m127-b1:", m127_b1({ribose: 64, splicer: 75, ligase: 81})?!)

gene m127_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m127_f0([14, 41, 11, 58, 39, 19, 39]) {

    case Ok(list) {

        print("m127-f0:", list.join("/"))

    }

    case Err(m) {

        print("m127-f0:", "e:", m)

    }

}

