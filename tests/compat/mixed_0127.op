# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=127 tag=m127

gene m127_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m127-b0:", m127_b0({cell: 34, ribose: 49, splicer: 15})?!)

