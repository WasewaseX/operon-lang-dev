gene m224_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m224-b0:", m224_b0({helix: 20, plasmid: 77, gene: 37})?!)

