gene m224_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m224_f0([51, 19, 8, 8, 31, 41, 49]) {

    case Ok(list) {

        print("m224-f0:", list.join("/"))

    }

    case Err(m) {

        print("m224-f0:", "e:", m)

    }

}

