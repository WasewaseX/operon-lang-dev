gene m235_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m235_f0([53, 36, 5, 56, 9]) {

    case Ok(list) {

        print("m235-f0:", list.join("/"))

    }

    case Err(m) {

        print("m235-f0:", "e:", m)

    }

}

