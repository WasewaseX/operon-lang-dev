gene m009_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m009_f0([50, 55, 32, 11, 27]) {

    case Ok(list) {

        print("m009-f0:", list.join("/"))

    }

    case Err(m) {

        print("m009-f0:", "e:", m)

    }

}

