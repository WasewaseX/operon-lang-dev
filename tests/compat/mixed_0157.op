gene m157_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m157_f0([55, 35, 5, 21]) {

    case Ok(list) {

        print("m157-f0:", list.join("/"))

    }

    case Err(m) {

        print("m157-f0:", "e:", m)

    }

}

