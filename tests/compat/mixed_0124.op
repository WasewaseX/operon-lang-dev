gene m124_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m124_f0([7, 19, 55, 48]) {

    case Ok(list) {

        print("m124-f0:", list.join("/"))

    }

    case Err(m) {

        print("m124-f0:", "e:", m)

    }

}

