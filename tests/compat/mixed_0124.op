gene m124_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m124-b0:", m124_b0({enzyme: 83, gene: 71, helix: 80})?!)

