gene m129_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m129_f0([22, 7, 2, 31, 42, 47, 25]) {

    case Ok(list) {

        print("m129-f0:", list.join("/"))

    }

    case Err(m) {

        print("m129-f0:", "e:", m)

    }

}

