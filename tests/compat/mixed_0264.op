# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=264 tag=m264

gene m264_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m264-b0:", m264_b0({gene: 99, splicer: 93, plasmid: 19})?!)

gene m264_b1(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m264-b1:", m264_b1({enzyme: 39, ribose: 72, gene: 83})?!)

gene m264_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m264_f0([41, 20, 49, 36]) {

    case Ok(list) {

        print("m264-f0:", list.join("/"))

    }

    case Err(m) {

        print("m264-f0:", "e:", m)

    }

}

