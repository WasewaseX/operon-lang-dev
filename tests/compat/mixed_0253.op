gene m253_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m253_f0([22, 40, 50, 36, 45, 48, 31, 28]) {

    case Ok(list) {

        print("m253-f0:", list.join("/"))

    }

    case Err(m) {

        print("m253-f0:", "e:", m)

    }

}

