print("m100-b2:", m100_b2({marker: 84, codon: 55, exon: 64})?!)

gene m100_f0(xs) {

    let evens = []

    for v in xs {

        if v % 2 == 0 {

            evens.push(v * 10)

        }

    }

    if evens.len() == 0 {

        return err("no evens")

    }

    return ok(evens)

}

match m100_f0([3, 3, 3, 2, 52, 47, 36, 32]) {

    case Ok(list) {

        print("m100-f0:", list.join("/"))

    }

    case Err(m) {

        print("m100-f0:", "e:", m)

    }

}

