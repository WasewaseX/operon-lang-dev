# compat corpus — generated, do not edit by hand
# bucket=mixed seed=20261030 idx=100 tag=m100

gene m100_b0(m) {

    let best = null

    let bv = -1

    for k in m {

        if m[k] > bv {

            bv = m[k]

            best = k

        }

    }

    return ok(best + "=" + str(bv))

}

print("m100-b0:", m100_b0({exon: 50, gene: 92, plasmid: 64})?!)

