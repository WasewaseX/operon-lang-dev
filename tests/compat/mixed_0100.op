let m100_cl0 = gene (x) {

    return gene (y) {

        return x * 100 + y

    }

}

print("m100-cc0:", m100_cl0(3)(11), m100_cl0(11)(3))

let m100_cl1 = gene (x) {

    return gene (y) {

        return x * 100 + y

    }

}

print("m100-cc1:", m100_cl1(7)(3), m100_cl1(3)(7))

let m100_data0 = some([some("codon"), none(), some(7)])

match m100_data0 {

    case Some([Some(s), none(), Some(n)]) {

        print("m100-x0:", s, n, s.len())

    }

    case _ {

        print("m100-x0:", "shape-miss")

    }

}

let m100_data1 = some([some("splicer"), none(), some(1)])

match m100_data1 {

    case Some([Some(s), none(), Some(n)]) {

        print("m100-x1:", s, n, s.len())

    }

