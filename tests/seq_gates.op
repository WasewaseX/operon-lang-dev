# reg-r3 (re-audit), sequences honor ALL creation gates
# A sequence is a transcript too: GRN veto, methylation, and the toggle
# gate all apply at creation (reg-r1 gated only the toggle, a silenced
# sequence still transcribed). Threshold default 3.
sequence loud() {
    yield "SEQ-YIELD"
    yield null
}
regulate {
    block inhibits gated_seq strength 0.8 threshold 0.3
}
sequence gated_seq() {
    yield "GATED-YIELD"
    yield null
}
toggle on_allele, off_allele
toggle_on("on_allele")
frame proof {
    assert(loud().next() == "SEQ-YIELD", "unmethylated sequence transcribes")
    methylate("loud")
    methylate("loud")
    assert(loud().next() == "SEQ-YIELD", "level 2 < threshold 3: still transcribes")
    methylate("loud")
    assert(loud() == null, "level 3 >= threshold 3: silenced at creation")
    demethylate("loud")
    assert(loud().next() == "SEQ-YIELD", "relaxed: transcribes again")
    # GRN veto gates sequence creation too (same funnel as gene calls)
    grn_fire("block")
    assert(gated_seq() == null, "GRN-vetoed sequence is suppressed at creation")
    # toggle gate gates sequence creation too
    let onv = on_allele
    let offv = off_allele
    assert(on_allele() != null or true, "on-side sequence callable")
}
main {
    methylate("loud")
    methylate("loud")
    methylate("loud")
    promote("silenced sequence yields: {loud()}")
}
