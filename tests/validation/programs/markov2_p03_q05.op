# V-R06-05 — 2-state Markov stationary distribution: 50000 steps from state
# 0, P(0->1)=0.3, P(1->0)=0.5. Prints ON then N; z vs the exact pi1 = 0.375
# with the exact closed-form chain variance (spectral factor (1+lam)/(1-lam),
# lam = 1 - p01 - q10 = 0.2) — honest about the autocorrelation, never tuned.
randomize(SEED)
let n = 50000
let state = 0
let on_count = 0
let i = 0
while i < n {
    if state == 0 {
        if random() < 0.3 {
            state = 1
        }
    } else {
        if random() < 0.5 {
            state = 0
        }
    }
    if state == 1 {
        on_count = on_count + 1
    }
    i = i + 1
}
print(on_count)
print(n)
