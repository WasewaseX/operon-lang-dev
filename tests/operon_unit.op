# reg-bio-3 (A1/A7): the namesake construct — the polycistronic operon.
# ONE promoter drives N cistrons on ONE transcript: a call to ANY cistron is
# a transcription attempt of the WHOLE unit, so an edge targeting the UNIT
# gates every member (induction acts on the unit's promoter). Per-cistron
# `rbs` is the translation-efficiency multiplier (Shine-Dalgarno strength) —
# the lacZYA stoichiometric gradient lives in the two-tier protein nodes.
# Polarity: upstream blocking (target-less RISC degradation) reduces
# downstream yield — polarity^(#blocked upstream), default 0.5.
regulate {
    activator activates lac strength 0.9 threshold 0.5
    lacZ translates pz rate 1.0
    lacY translates py rate 1.0
    lacA translates pa rate 1.0
}
gene lacZ() { return "z" }
gene lacY() { return "y" }
gene lacA() { return "a" }
operon lac { lacZ rbs 1.0; lacY rbs 0.6; lacA rbs 0.3; }
frame proof {
    # unit gate closed: EVERY cistron is blocked by the unit-level edge
    assert(lacZ() == null, "unit gate closed: the edge to 'lac' vetoes Z")
    assert(lacY() == null, "unit gate applies to every member (Y)")
    assert(lacA() == null, "unit gate applies to every member (A)")
    assert(fingerprint().transcripts.lac == 0, "suppressed calls are not expression: no transcripts")
    # induction acts on the UNIT — one edge opens all three cistrons
    grn_set("activator", 0.9)
    assert(lacZ() == "z", "induced unit: Z expresses")
    assert(lacY() == "y", "induced unit: Y expresses through the same unit gate")
    assert(lacA() == "a", "induced unit: A expresses through the same unit gate")
    assert(fingerprint().transcripts.lac == 3, "three successful cistron calls = three unit transcripts")
    # the stoichiometric gradient: rbs scales each cistron's translation
    grn_fire("activator")
    assert(abs(grn_get("pz") - 1.0) < 1e-12, "Z protein at rbs 1.0 -> 1.0")
    assert(abs(grn_get("py") - 0.6) < 1e-12, "Y protein at rbs 0.6 -> 0.6 (RBS gradient)")
    assert(abs(grn_get("pa") - 0.3) < 1e-12, "A protein at rbs 0.3 -> 0.3 (RBS gradient)")
    # transcriptional polarity: degrading the FIRST cistron cuts the yield
    # of everything downstream of it (Rho-termination proxy, 0.5 default).
    # The protein tier integrates at engine update points, so each polarity
    # step is observed after a grn_fire pulse.
    silence lacZ;
    assert(lacZ() == null, "degraded upstream cistron: captured call returns null")
    assert(fingerprint().transcripts.lac == 3, "degraded calls make no transcript")
    lacY()
    lacA()
    grn_fire("activator")
    assert(abs(grn_get("py") - 0.9) < 1e-12, "one blocked upstream: Y yield 0.6 + 0.6*0.5 = 0.9 (polarity)")
    assert(abs(grn_get("pa") - 0.45) < 1e-12, "one blocked upstream: A yield 0.3 + 0.3*0.5 = 0.45 (polarity)")
    silence lacY;
    lacA()
    grn_fire("activator")
    assert(abs(grn_get("pa") - 0.525) < 1e-12, "two blocked upstream: 0.45 + 0.3*0.25 = 0.525 (polarity compounds)")
}
main {
    grn_set("activator", 0.9)
    promote("unit gate closed check: {lacZ()}")
    grn_set("activator", 0.9)
    promote("z: {lacZ()} y: {lacY()} a: {lacA()}")
    promote("transcripts: {fingerprint().transcripts.lac}")
}
