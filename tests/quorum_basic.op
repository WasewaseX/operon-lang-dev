# loop-9 (C8): quorum sensing — the population layer, part 1: the pool.
# Real biology: LuxI synthase charges the medium with AHL; extracellular
# concentration scales with cell density; AiiA lactonase quenches it.
# Operon models the medium as INTEGER molecule counts (u64, cap 1e9 =
# level 1.0) — exact, order-free accumulation, and the only float op is
# the read-side division count/1e9.
# Fails-pre: quorum/secrete/quench/quorum_state were phantom calls
# returning null — every assert burns on the pre-loop-9 core.
autoinducer ahl
frame proof {
    assert(quorum("ahl") == 0.0, "empty medium: level 0.0")
    assert(quorum("ahl", 0.1) == false, "empty medium: quorum below threshold is false")
    secrete("ahl", 500000000)
    assert(quorum("ahl") == 0.5, "5e8 molecules = level 0.5 exactly (binary-exact division)")
    secrete("ahl", 500000000)
    assert(quorum("ahl") == 1.0, "1e9 molecules = level 1.0 (saturated medium)")
    secrete("ahl", 500000000)
    assert(quorum("ahl") == 1.0, "saturation: 1.5e9 requested clamps at 1e9 — never more")
    secrete("b", 0.7)
    assert(quorum("b") == 0.0, "Float 0.7 floors to 0 molecules (floor, never round)")
    secrete("c", -5)
    assert(quorum("c") == 0.0, "negative amount clamps to 0 molecules")
    assert(quorum("never_declared") == 0.0, "unknown species reads level 0.0 (auto-register on secrete only)")
    quench("ahl")
    assert(quorum("ahl") == 0.0, "full quench destroys all signal (AiiA lactonase)")
    secrete("ahl", 800000000)
    quench("ahl", 0.5)
    assert(quorum("ahl") == 0.4, "50% quench: 4e8 molecules left -> level 0.4 exactly")
    let st = quorum_state()
    assert(st.ahl == 400000000, "quorum_state carries molecule counts (ahl)")
    assert(st.b == 0, "quorum_state carries molecule counts (b, floored to 0)")
    assert(len(st) == 3, "quorum_state lists exactly the registered species")
}
