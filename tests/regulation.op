regulate {
    signal activates kinase strength 0.9
    kinase activates factor
    toxin inhibits kinase strength 0.8
}
toggle activator, repressor
repressilator a -> b -> c
frame proof {
    # GRN: activation propagates, inhibition subtracts
    let lv = grn_fire("signal")
    assert(lv.signal == 1.0, "grn seed")
    assert(lv.kinase > 0.0 and lv.kinase <= 0.9, "grn activation with decay")
    assert(lv.factor > 0.0, "grn cascade")
    let lv2 = grn_fire("toxin")
    assert(lv2.kinase < 0.9, "grn inhibition reduces")

    # toggle latch: exactly one on
    toggle_on("activator")
    let st = toggle_state()
    assert(st.activator == true, "toggle on")
    assert(st.repressor == false, "mutual repression")

    # repressilator manual ring, A11: emergent mutual repression (the ring
    # integrates the Elowitz–Leibler model; nothing is scheduled)
    repressi_next()
    repressi_next()
    let rs = repressi_state()
    assert(rs.a > 0.0 and rs.b > 0.0, "ring nodes alive")
    assert(rs.a != rs.b, "nodes desynchronized: emergent phases")
    # determinism: state is a pure function of the tick count
    let rs2 = repressi_state()
    assert(rs2.a == rs.a and rs2.b == rs.b, "stateless fold: same tick, same levels")
}
