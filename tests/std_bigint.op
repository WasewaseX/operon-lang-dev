# W32: std/bigint, exact arbitrary-precision arithmetic over sign-magnitude
# base-10^4 digit lists (the sanctioned tutorial path past the i64 no-wrap
# contract). Pins representation canonicalization, the full sign matrix,
# known exact values, and the to_int boundary armor.
# Companion: tests/differential/bigint.op (byte-identical, both engines).

use std/bigint;

gene t(x) {
    return bigint.big_to_str(x)
}

frame proof {
    # --- representation canonicalization
    assert(t(bigint.big_zero()) == "0", "zero prints 0")
    assert(t(bigint.big_from_int(0)) == "0", "from_int 0")
    assert(t(bigint.big_neg(bigint.big_zero())) == "0", "neg zero normalizes")
    assert(bigint.big_neg(bigint.big_zero()) == bigint.big_zero(), "neg zero == zero")
    assert(bigint.big_is_zero(bigint.big_from_str("0000")), "0000 is zero")
    assert(bigint.big_from_str("-0") == bigint.big_zero(), "-0 canonicalizes to +0")

    # --- round-trips (structural ==: normalized limbs make lists comparable)
    assert(bigint.big_from_str("123456789012345678901234567890") == bigint.big_from_str("0123456789012345678901234567890"), "leading zeros equal")
    assert(t(bigint.big_from_str("+007")) == "7", "plus + leading zeros")
    assert(t(bigint.big_from_int(-25)) == "-25", "negative from_int")

    # --- parse rejections: null, never a guess
    assert(bigint.big_from_str("") == null, "empty")
    assert(bigint.big_from_str("-") == null, "bare minus")
    assert(bigint.big_from_str("+") == null, "bare plus")
    assert(bigint.big_from_str("12a4") == null, "letter digit")
    assert(bigint.big_from_str("1 2") == null, "space digit")
    assert(bigint.big_from_str("0x10") == null, "no hex here")

    # --- sign matrix for add (all four cells + carry chain)
    assert(t(bigint.big_add(bigint.big_from_int(5), bigint.big_from_int(3))) == "8", "5+3")
    assert(t(bigint.big_add(bigint.big_from_int(-5), bigint.big_from_int(3))) == "-2", "-5+3")
    assert(t(bigint.big_add(bigint.big_from_int(5), bigint.big_from_int(-3))) == "2", "5-3")
    assert(t(bigint.big_add(bigint.big_from_int(-5), bigint.big_from_int(-3))) == "-8", "-5-3")
    assert(t(bigint.big_add(bigint.big_from_int(5), bigint.big_from_int(-5))) == "0", "cancellation")
    assert(t(bigint.big_add(bigint.big_from_int(99999999), bigint.big_from_int(1))) == "100000000", "limb carry")
    assert(t(bigint.big_add(bigint.big_from_str("99999999999999999999"), bigint.big_from_int(1))) == "100000000000000000000", "multi-limb carry")

    # --- sub via negation, sign-correct in every direction
    assert(t(bigint.big_sub(bigint.big_from_int(8), bigint.big_from_int(5))) == "3", "8-5")
    assert(t(bigint.big_sub(bigint.big_from_int(5), bigint.big_from_int(8))) == "-3", "5-8")
    assert(t(bigint.big_sub(bigint.big_zero(), bigint.big_zero())) == "0", "0-0")
    assert(bigint.big_sub(bigint.big_from_int(3), bigint.big_from_int(3)) == bigint.big_zero(), "x-x is canonical zero")

    # --- mul: schoolbook, known exact products
    assert(t(bigint.big_mul(bigint.big_from_int(123456789), bigint.big_from_int(987654321))) == "121932631112635269", "famous product")
    assert(t(bigint.big_mul(bigint.big_from_int(-3), bigint.big_from_int(7))) == "-21", "sign propagation")
    assert(t(bigint.big_mul(bigint.big_from_int(-3), bigint.big_from_int(-7))) == "21", "double negative")
    assert(bigint.big_mul(bigint.big_from_int(12345), bigint.big_from_int(0)) == bigint.big_zero(), "mul zero canonical")

    # --- pow / fact: the canonical i64 escape demos
    assert(t(bigint.big_pow(bigint.big_from_int(2), 128)) == "340282366920938463463374607431768211456", "2**128")
    assert(t(bigint.big_pow(bigint.big_from_int(10), 40)) == "10000000000000000000000000000000000000000", "10**40")
    assert(bigint.big_pow(bigint.big_from_int(2), 0) == bigint.big_from_int(1), "x**0")
    assert(bigint.big_pow(bigint.big_from_int(2), -1) == null, "negative exponent")
    assert(bigint.big_pow(bigint.big_from_int(2), 1.5) == null, "non-int exponent")
    assert(t(bigint.big_fact(20)) == "2432902008176640000", "20! still fits i64")
    assert(t(bigint.big_fact(21)) == "51090942171709440000", "21! already does not")
    assert(t(bigint.big_fact(30)) == "265252859812191058636308480000000", "30! exact")
    assert(bigint.big_fact(-1) == null, "negative factorial")

    # --- ordering: full signed cmp matrix
    assert(bigint.big_cmp(bigint.big_from_int(3), bigint.big_from_int(5)) == -1, "3<5")
    assert(bigint.big_cmp(bigint.big_from_int(5), bigint.big_from_int(3)) == 1, "5>3")
    assert(bigint.big_cmp(bigint.big_from_int(-3), bigint.big_from_int(-5)) == 1, "-3>-5 (magnitude flips)")
    assert(bigint.big_cmp(bigint.big_from_int(-5), bigint.big_from_int(3)) == -1, "neg<pos")
    assert(bigint.big_cmp(bigint.big_zero(), bigint.big_from_str("-0")) == 0, "0==-0")

    # --- to_int boundary armor: exact inside i64, null outside, never a clamp
    assert(bigint.big_to_int(bigint.big_from_int(-9223372036854775807)) == -9223372036854775807, "-MAX round-trips")
    assert(bigint.big_to_int(bigint.big_from_str("9223372036854775807")) == 9223372036854775807, "MAX round-trips")
    assert(bigint.big_to_int(bigint.big_from_str("9223372036854775808")) == null, "2**63 is null (differs from MAX only in the low limb)")
    assert(bigint.big_to_int(bigint.big_from_str("-9223372036854775808")) == null, "-2**63 is null")
    assert(bigint.big_to_int(bigint.big_from_str("99999999999999999999999")) == null, "way out is null")
    assert(bigint.big_to_int(bigint.big_zero()) == 0, "zero to_int")

    # --- algebra spot-checks (deterministic, no entropy)
    let a = bigint.big_from_str("98765432109876543210")
    let b = bigint.big_from_str("12345678901234567890")
    let c = bigint.big_from_str("55555555555555555555")
    assert(bigint.big_add(bigint.big_mul(a, c), bigint.big_mul(b, c)) == bigint.big_mul(bigint.big_add(a, b), c), "distributive")
    assert(bigint.big_add(a, b) == bigint.big_add(b, a), "commutative")
    assert(bigint.big_add(bigint.big_add(a, b), c) == bigint.big_add(a, bigint.big_add(b, c)), "associative")
}
