# incoherent FFL: X -> Z, X -> Y -| Z — pulse generator + adaptation (C6).
# Real biology: an incoherent feed-forward loop produces a BOUNDED pulse of
# Z in response to sustained X — the repressor arm (Y, translated) catches
# up and cancels the direct arm while the input stays ON (adaptation, not a
# latch); removing and re-applying the input re-pulses. DinJ-YafN / gal-style
# incoherence.
# Every intermediate value below is pinned from the shared deterministic
# op order and verified identical on BOTH cores (Rust + oracle). Each
# SUCCESSFUL z() probe is itself one clock tick that decays yp by 0.1 —
# the pulse window is probe-aware by construction (time is expression).
# Fails-pre: a core whose inhibitors veto permanently (no recovery) or
# that lacks the protein tier cannot show the bounded window + re-pulse.
# NOTE: one gene call per line — multiple calls on one line wobble
# ("expression statement not terminated; rest of line skipped").
regulate {
    x activates z strength 1.0 threshold 0.5
    x activates y strength 1.0 threshold 0.3
    y translates yp rate 0.2 decay 0.1
    yp inhibits z strength 1.0 threshold 0.5
}
gene x() { return "x-tx" }
gene y() { return "y-tx" }
gene z() { return "z-OUT" }
frame proof {
    decay_clock(1, 0.0)
    grn_fire("x")
    assert(z() == "z-OUT", "pulse tick 0: repressor protein absent, Z fires")
    y()
    assert(z() == "z-OUT", "pulse tick 1: yp 0.18 < 0.5 - Z still fires")
    y()
    assert(z() == "z-OUT", "pulse tick 2: yp 0.3258 < 0.5 - Z still fires")
    y()
    assert(z() == "z-OUT", "pulse tick 3: yp 0.443898 < 0.5 - last fire of the window")
    y()
    assert(z() == null, "tick 4: yp 0.5995082 >= 0.5 - the pulse ENDS while X stays ON")
    assert(z() == null, "adapted: sustained input, Z silent (not a latch)")
    grn_set("x", 0.0)
    assert(z() == null, "input off: Z off immediately")
    # idle ticks drain the repressor tier (each call integrates yp x0.9)
    x()
    x()
    x()
    x()
    x()
    x()
    assert(grn_get("yp") < 0.5, "repressor decayed below threshold during input-off (0.5995 x 0.9^6 = 0.3186)")
    grn_set("x", 1.0)
    assert(z() == "z-OUT", "re-induction: Z pulses again (adaptation cycle)")
    y()
    y()
    y()
    y()
    assert(z() == null, "and adapts again: bounded pulse, not a latch")
}
