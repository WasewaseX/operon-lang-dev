# loop-10 (F-8): the ribosome-queue coupling shield. A healthy upstream
# cistron that actually transcribed grows the whole unit's queue by each
# member's rbs (initiation propensity, capped); queue depth >=
# rho.queue_floor occludes rut sites, so Rho cannot fire behind it — the
# transcription-translation coupling trait. Captured calls grow nothing
# (their transcript never existed). Integration ticks drain every queue by
# ribosome.drain; a drained queue re-exposes the rut sites.
# catch = 1.0 makes termination deterministic, so the SHIELD is the only
# thing that can save the call — every outcome below is the shield's effect.
regulate {
    a translates pa rate 0.4
    b translates pb rate 0.4
    c translates pc rate 0.4
}
gene a() { return "a" }
gene b() { return "b" }
gene c() { return "c" }
operon abc { a rbs 1.0; b rbs 0.6; c rbs 0.3; }
silence b strength 0.5;
frame proof {
    # phase 1: b transcribes with seeded escapes — every escaped call grows
    # the queue; captured calls (null) grow nothing
    randomize(3)
    let ok = 0
    for i in range(12) {
        if b() != null { ok = ok + 1 }
    }
    assert(ok == 2, "seeded escape count for b at p=0.5 (calibration pin)")
    # q_b is capped at 1.0 >= floor 0.5 → shielded: catch 1.0 cannot fire
    randomize(3)
    assert(c() == "c", "ribosome occupancy shields b: Rho cannot terminate behind a translated cistron")
    # phase 2: one integration tick drains every queue by 0.5 — q_b lands
    # exactly ON the floor; >= keeps the shield up (boundary pin)
    grn_fire("a")
    randomize(3)
    assert(c() == "c", "queue at exactly the floor (0.5): the shield still holds (>= boundary)")
    # phase 3: two drains with NO intervening calls — q_b 1.0 -> 0.5 -> 0.0
    grn_fire("a")
    grn_fire("a")
    randomize(3)
    assert(c() == null, "drained queue (0.0 < floor): rut sites re-exposed — Rho terminates")
}
main {
    randomize(3)
    let ok = 0
    for i in range(12) { if b() != null { ok = ok + 1 } }
    promote("b escapes: {ok}")
    randomize(3)
    promote("c shielded: {c()}")
    grn_fire("a")
    randomize(3)
    promote("c at-floor: {c()}")
    grn_fire("a")
    grn_fire("a")
    randomize(3)
    promote("c drained: {c()}")
}
