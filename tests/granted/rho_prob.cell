# loop-10 (F-7): explicit operator cell — the probabilistic arm: catch 0.5
# (distance decay q = 1−(1−catch)^d — pressure GROWS with the runway).
# queue_cap 0.0 keeps every cistron unshielded
# so the statistics measure the DISTANCE DECAY alone (with the default cap,
# read-through calls grow the unit queue and the coupling shield kicks in —
# that feedback is pinned separately in rho_queue_shield.op). Statistical
# pins are exact under the shared mirrored stream (Rust and oracle consume
# identical draws).
[rho]
termination = true
catch = 0.5
[ribosome]
queue_cap = 0.0
