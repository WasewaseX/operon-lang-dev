# std/url: percent-encoding and URL shaping (pure, canonical, lenient decode).
use std/url as u

frame proof {
    # encode: everything outside the unreserved set becomes %XX uppercase
    assert(u.url_encode("a b/c~d_e.f-g") == "a%20b%2Fc~d_e.f-g")
    assert(u.url_encode("") == "")
    assert(u.url_encode("AZaz09") == "AZaz09")
    assert(u.url_encode("&=") == "%26%3D")

    # decode: %XX and '+' to space, malformed escapes kept verbatim
    assert(u.url_decode("a%20b+c%2Fd") == "a b c/d")
    assert(u.url_decode("no%zz escapes") == "no%zz escapes")
    assert(u.url_decode("") == "")

    # round-trip on a mixed payload
    let payload = "q a/x~y=z&more"
    assert(u.url_decode(u.url_encode(payload)) == payload)

    # parse: scheme, host, port, path, query map with decoded values
    let m = u.url_parse("https://example.org:8443/a/b?x=1&y=a%20b")
    assert(m["scheme"] == "https" and m["host"] == "example.org")
    assert(m["port"] == "8443" and m["path"] == "/a/b")
    assert(m["query"]["x"] == "1" and m["query"]["y"] == "a b")

    # parse: no scheme, no query, bare host forms
    let bare = u.url_parse("/just/a/path")
    assert(bare["scheme"] == "" and bare["path"] == "/just/a/path")
    let hostonly = u.url_parse("ftp://files.example.org")
    assert(hostonly["scheme"] == "ftp" and hostonly["host"] == "files.example.org")
    assert(hostonly["port"] == "" and hostonly["path"] == "")

    # query_encode: canonical sorted-key output, both sides encoded
    assert(u.url_query_encode({z: "1 2", a: "&="}) == "a=%26%3D&z=1%202")
    assert(u.url_query_encode({}) == "")

    # a parsed query re-encodes to a canonical form
    let back = u.url_query_encode(u.url_parse("https://h/p?b=2&a=1")["query"])
    assert(back == "a=1&b=2")

    # utf-8 byte law: scalars >= 128 encode one %XX per UTF-8 byte
    assert(u.url_encode("中") == "%E4%B8%AD")
    assert(u.url_encode("é") == "%C3%A9")
    assert(u.url_encode("€") == "%E2%82%AC")
    assert(u.url_encode("🌍") == "%F0%9F%8C%8D")
    assert(u.url_decode("%E4%B8%AD") == "中")
    assert(u.url_decode("%C3%A9") == "é")
    assert(u.url_decode("%F0%9F%8C%8D") == "🌍")

    # round-trip law on a non-ASCII payload
    let zh = "中文 x/y?z&мир 🌍"
    assert(u.url_decode(u.url_encode(zh)) == zh)

    # lenient fallback: truncated runs and lone leads fall back byte-wise
    assert(u.url_decode("%E4%B8") == chr(228) + chr(184))
    assert(u.url_decode("%E4") == chr(228))
    assert(u.url_decode("%C3") == chr(195))
    assert(u.url_decode("%E4xyz") == chr(228) + "xyz")
    assert(u.url_decode("a%E4%B8%ADb%zz") == "a中b%zz")

    # utf-8 boundary law: continuation-passing runs that violate the
    # second-byte boundary fall back byte-per-octet (never an invalid scalar)
    assert(u.url_decode("%E0%80%80") == chr(224) + chr(128) + chr(128))
    assert(u.url_decode("%E0%9F%BF") == chr(224) + chr(159) + chr(191))
    assert(u.url_decode("%ED%A0%80") == chr(237) + chr(160) + chr(128))
    assert(u.url_decode("%ED%BF%BF") == chr(237) + chr(191) + chr(191))
    assert(u.url_decode("%F0%80%80%80") == chr(240) + chr(128) + chr(128) + chr(128))
    assert(u.url_decode("%F4%90%80%80") == chr(244) + chr(144) + chr(128) + chr(128))

    # boundary-exact valid scalars still reassemble
    assert(u.url_decode("%E0%A0%80") == chr(2048))
    assert(u.url_decode("%ED%9F%BF") == chr(55295))
    assert(u.url_decode("%F0%90%80%80") == chr(65536))
    assert(u.url_decode("%F4%8F%BF%BF") == chr(1114111))
    assert(u.url_decode("x%E0%A0%80y%E0%9F%BFz") == "x" + chr(2048) + "y" + chr(224) + chr(159) + chr(191) + "z")
    let edges = chr(2047) + chr(2048) + chr(55295) + chr(65535) + chr(65536) + chr(1114111)
    assert(u.url_decode(u.url_encode(edges)) == edges)

    promote("url: all asserts green")
}
