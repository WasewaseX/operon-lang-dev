# W06 stage 2 — try_* family: Result-returning variants of the
# failure-prone core builtins (SPEC §9 compat note). The legacy null
# contracts are untouched; try_* additions are pinned here AND as a
# differential target (tests/differential/try_family.op).

frame proof {
    # ---- try_num: int-first parse, then float, raw string in the payload
    assert(is_ok(try_num("42")), "int parse is Ok")
    assert(try_num("42") == ok(42), "payload is the int")
    assert(try_num(" 2.5 ") == ok(2.5), "trim then float")
    assert(is_err(try_num("x9")), "bad string is Err")
    assert(try_num("x9") == err("num('x9') failed"), "exact message shape")
    assert(try_num(7) == ok(7), "passthrough int")
    assert(is_err(try_num([1])), "non-scalar refused as Err, not a stress")

    # ---- try_index: range-checked read
    let l = [10, 20]
    assert(try_index(l, 0) == ok(10), "in range is Ok")
    assert(try_index(l, 2) == err("index 2 out of range for list of length 2"), "exact range message")
    assert(is_err(try_index(l, -1)), "negative refused")
    assert(is_err(try_index("no", 0)), "non-list refused")

    # ---- try_get: map lookup without the null+note miss
    let m = {a: 1}
    assert(try_get(m, "a") == ok(1), "hit is Ok")
    assert(is_err(try_get(m, "zz")), "miss is Err")
    assert(is_err(try_get(l, "a")), "non-map refused")

    # ---- try_pop: mutating pop as a Result
    let p = [1]
    assert(try_pop(p) == ok(1), "pop returns the value")
    assert(len(p) == 0, "pop mutates")
    assert(is_err(try_pop(p)), "empty pop is Err, not a note")

    # ---- composition with ?! and rescue (D-014 contract)
    gene read_at(list, i) {
        return try_index(list, i)?!
    }
    gene rescue_demo(list, i) {
        stress {
            let v = read_at(list, i)?!
            return ok(v)
        } rescue (e) {
            return err(e.kind)
        }
    }
    assert(read_at(l, 1) == 20, "?! unwraps Ok to the payload")
    assert(rescue_demo(l, 99) == err("index 99 out of range for list of length 2"), "propagated Err IS the return value (crosses rescue, D-014)")
    assert(rescue_demo(l, 0) == ok(10), "normal flow through the same rescue")
    # the unwrap BUILTIN (not ?!) is the rescue-catchable exceptional tier
    let caught_kind = ""
    stress {
        unwrap(try_num("nope"))
    } rescue (e) {
        caught_kind = e.kind
    }
    assert(caught_kind == "unwrap", "unwrap on Err raises the catchable unwrap stress")

    # ---- the LEGACY contracts did not move (2.x compat): num stays
    # null-contract; the missing/index surfaces stay tier-3 `missing`
    # stresses — that is exactly why the try_* additions exist
    assert(num("nope") == 0, "num stays null-contract (0 + note)")
    let mut_probe = []
    let legacy_pop = pop(mut_probe)
    assert(legacy_pop == null, "pop stays null-contract on empty")
    let legacy_key_kind = ""
    stress {
        let m2 = {}
        m2["zz"]
    } rescue (e) {
        legacy_key_kind = e.kind
    }
    assert(legacy_key_kind == "missing", "missing key read stays a missing stress")
    let legacy_idx_kind = ""
    stress {
        let l2 = [1]
        l2[5]
    } rescue (e) {
        legacy_idx_kind = e.kind
    }
    assert(legacy_idx_kind == "missing", "out-of-range read stays a missing stress")

    # ---- WAVE 2 (v2.7.0): extraction, environment, parsing families.
    # Same law: Result-returning additions, Err payloads are message Strs.
    # ---- try_first / try_last
    assert(try_first([10, 20]) == ok(10), "first hit is Ok")
    assert(try_first("héllo") == ok("h"), "first is char-indexed")
    assert(try_first([]) == err("first of an empty list"), "exact empty-list message")
    assert(try_first("") == err("first of an empty string"), "exact empty-string message")
    assert(try_first({a: 1}) == err("first of a map"), "non-sequence refused as Err, not a stress")
    assert(try_first(null) == err("first of a null"), "null refused as Err")
    assert(try_last([10, 20]) == ok(20), "last hit is Ok")
    assert(try_last("héllo") == ok("o"), "last is char-indexed")
    assert(try_last([]) == err("last of an empty list"), "exact empty-list message")
    assert(try_last(42) == err("last of a int"), "non-sequence refused as Err")

    # ---- try_char_at: char-indexed read as a Result (try_index shape)
    let s2 = "héllo"
    assert(try_char_at(s2, 1) == ok("é"), "char index is scalar-value based")
    assert(try_char_at(s2, -1) == ok("o"), "negative index resolves from the end")
    assert(try_char_at(s2, 5) == err("char_at index 5 out of range for string of length 5"), "exact range message")
    assert(is_err(try_char_at("abc", 1.5)), "non-int index is Err, not a stress")

    # ---- try_env: zero-grant contract (the Err/Ok granted lane lives in
    # tests/granted/try_env_wave2.op, explicit cell, same discipline as
    # std/env). Denial happens BEFORE the lookup — even a never-set name
    # refuses with interference, the Err path is unreachable zero-grant.
    let env_denied_kind = ""
    stress {
        try_env("PATH")
        assert(false, "try_env must be denied by default")
    } rescue (e) {
        env_denied_kind = e.kind
    }
    assert(env_denied_kind == "interference", "capability denial stays a stress in the try_ variant")

    # ---- try_json_parse: malformed JSON is an inspectable Err
    # (object braces built via chr(123)/chr(125): a bare { in a string
    # literal starts interpolation, SPEC)
    let OB = chr(123)
    let CB = chr(125)
    assert(try_json_parse("  42  ") == ok(42), "valid scalar JSON is Ok")
    assert(try_json_parse("[1, 2]") == ok([1, 2]), "valid array JSON is Ok")
    assert(try_json_parse(OB + "\"a\": 1" + CB) == ok({a: 1}), "valid object JSON is Ok")
    assert(try_json_parse(OB + "bad") == err("json_parse('" + OB + "bad') failed"), "exact raw-input message")
    assert(is_err(try_json_parse("")), "empty input is Err")
    assert(is_err(try_json_parse("[1,")), "truncated array is Err")

    # ---- try_re_groups: no-match / malformed pattern are Errs
    assert(try_re_groups("(a+)(b*)", "aabbb") == ok(["aa", "bbb"]), "groups are Ok on match")
    assert(try_re_groups("(a+)(b*)", "ccc") == err("no match"), "exact no-match message")
    assert(try_re_groups("(a)|(b)", "b") == ok([null, "b"]), "unmatched group stays null inside Ok")
    assert(try_re_groups("[unclosed", "abc") == err("re_groups('[unclosed') failed"), "malformed pattern is Err, not a stress")
    let re_ovf_left = ""
    stress {
        try_re_groups("(a+)(b*)", "ccc")
    } rescue (e) {
        re_ovf_left = "should not run"
    }
    assert(re_ovf_left == "", "no-match does NOT stress (the 2M-step ceiling is the only overflow path)")

    # ---- the LEGACY wave-2 contracts did not move (2.x compat)
    assert(first([]) == null, "first stays null-contract on empty")
    assert(last("") == null, "last stays null-contract on empty")
    assert(char_at("abc", 9) == null, "char_at stays null-contract on OOB")
    let legacy_env_kind = ""
    stress {
        env("OPERON_UNSET_WAVE2_PROBE")
        assert(false, "legacy env must be denied by default")
    } rescue (e) {
        legacy_env_kind = e.kind
    }
    assert(legacy_env_kind == "interference", "legacy env keeps the zero-grant refusal (granted null-contract pinned in tests/granted/try_env_wave2.op)")
    let jp_kind = ""
    stress {
        json_parse(OB + "bad")
    } rescue (e) {
        jp_kind = e.kind
    }
    assert(jp_kind == "unfolded", "json_parse stays an unfolded stress on malformed input")
    assert(re_groups("(a+)(b*)", "ccc") == null, "re_groups stays null-contract on no-match")

    # ---- composition: wave 2 through ?! and unwrap_or
    gene head_or_propagate(x) {
        return try_first(x)?!
    }
    assert(head_or_propagate([7]) == 7, "?! unwraps Some-shaped Ok")
    assert(unwrap_or(try_first([]), "dflt") == "dflt", "unwrap_or default on Err")
    assert(unwrap_or(try_first([1]), "dflt") == 1, "unwrap_or payload passthrough")
}
