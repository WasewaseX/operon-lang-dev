# Z-NOTEPARITY-1: stress MESSAGE TEXT is the contract (rust==oracle).
# The engine routes /,//,%,** through as_floats (interp.rs Div/FloorDiv/Mod/Pow
# arms) -- non-numeric operands render "numeric op needs numbers, found X and Y";
# '-' and '*' keep the arith "cannot apply" fallthrough (probe-verified controls).
# Filed from PR #217's note-parity receipt (items 2+3); item 1 (stress-contained
# note line prefix) is DEFERRED-DOCUMENTED per the as_map dx-r3 design note.
main {
    stress { let x = null / null } rescue (e) { print("div-null: " + e.message) }
    stress { let x = 1 / null } rescue (e) { print("div-mixed: " + e.message) }
    stress { let x = null // null } rescue (e) { print("floordiv: " + e.message) }
    stress { let x = null % null } rescue (e) { print("mod: " + e.message) }
    stress { let x = null ** null } rescue (e) { print("pow: " + e.message) }
    stress { let x = 1 - null } rescue (e) { print("sub-control: " + e.message) }
    stress { let x = null * null } rescue (e) { print("mul-control: " + e.message) }
    # --- F-DELNOTE rows (L-050): the del() fallback arm notes + nulls ------
    # (the method form m.del(k) has its OWN dispatch arm and stays silent by
    # design; these rows pin the FREE-FUNCTION del() misuse family only)
    let dm = {a: 1}
    print("del-1arg", del(dm))
    print("del-0arg", del())
    print("del-nonmap", del(7, 1))
    print("del-list", del([1, 2], 0))
    print("del-ok", del(dm, "a"), dm)
    print("del-nullkey", del(dm, null), dm)
    print("del-str", del("s", 1))
    print("noteparity-done")
}
