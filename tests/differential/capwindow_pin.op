# capwindow-pin (L-053 / Z-CAPWINDOW): the 4096 parser-budget
# transition window is a THREE-LANE law, pinned byte-identical on
# VM, tree-walk and oracle.
#
#   The engine's 4096-budget check lived at the HEAD of parse_unary
#   (the head of EVERY expression chain) while the oracle checks only
#   at recursive-arm ENTRY, pre-consume: the innermost content of the
#   4095th nested paren/call/block parsed at depth 4096 and was
#   rejected one level before any arm could trip - rust null vs
#   oracle 1, deterministic, on every shape class. Deep unary chains
#   died at 4095 on the engine while the oracle never tripped at all
#   (its unary() charged no depth; Python native ~150k). The check
#   now lives at the Minus/Tilde arm entries on BOTH engines,
#   op-for-op, with the same skip-to-statement-end containment.
#
#   The window also exposed a note-location class: the call-repair
#   notes (missing/extra argument) render LOCATED at the gene def
#   line on the engine (A13/dx-r2) but rendered UNLOCATED on the
#   oracle (corpus-unexposed: no corpus call ever misses an
#   argument). The oracle now carries Gene.line (mirror of
#   GeneDef.line) and stamps both repair notes with it.
#
# Layout note: every row marker is followed by a `let _sepN = 0` separator
# statement. Without it, the bare-name-definition lookahead
# (NAME ( ... ) -> newline-skip -> '{') reads a following block row's
# opening brace across the statement boundary and eats the marker as
# a gene definition - a PRE-EXISTING statement-adjacency hazard
# (disclosed in the PR, NOT pinned here: both engines derail
# identically, pinning it would encode a bug as law).
#
# Boundaries post-fix (both engines, byte-identical stdout):
#   paren/call : N<=4095 the value; N>=4096 null (arm-entry trip).
#   block      : N<=4095 prints 1; N=4096 empty (print's call arm
#                trips, zero-arg promote); N>=4097 nothing (block
#                arm trips, body dropped).
#   unary      : N<=4095 the parity value; N>=4096 the Minus/Tilde
#                arm trips (skip-to-statement-end containment): the
#                print's argument becomes a 4095-deep unary chain over
#                null, whose evaluation raises a CONTAINED stress
#                (cannot negate/bit-invert null) - empty stdout, the
#                cap note + the contained-stress note on stderr,
#                identical on every lane.
#

print("r1 paren N=4094 clean")
let _sep1 = 0
print(((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((