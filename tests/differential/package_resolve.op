# package_resolve - differential pin for the operon_modules import path
# (ai/ecosystem W19): a bare `use demo_pkg` resolves into the installed
# registry layout at operon_modules/demo_pkg/demo_pkg.op on both cores.
# Everything asserted here depends on package resolution succeeding; a
# resolution divergence shows up as a note on one engine only.

use demo_pkg

frame proof {
    assert(demo_pkg.twice(21) == 42, "installed package gene call");
    assert(demo_pkg.shout("hot") == "HOT!", "installed package string gene");
    assert(demo_pkg.label == "demo", "installed package data let");
    assert(demo_pkg.version[2] == 0, "installed package list let");
}

# flat-bind: the module map is also addressable without the alias
promote(twice(5))
promote(label)
promote(type(demo_pkg))
