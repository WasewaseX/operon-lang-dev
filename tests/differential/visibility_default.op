# differential: W24 default mode — `pub` is INERT (zero behavior change).
# Without the strict cell, the module exports everything (default-open),
# and `pub gene`/`pub let` names are reachable both ways. Byte-identical.
use vis_lib;
gene main() {
    print(vis_lib.visible(21), vis_lib.VERSION)
    print(vis_lib.hidden_helper(1))
    print(hidden_helper(2))
    print(has(vis_lib, "visible"), has(vis_lib, "hidden_helper"))
    print(has(vis_lib, "VERSION"), has(vis_lib, "SECRET"))
    # `pub` stays an ordinary identifier when not used as a marker
    let pub = 7
    print(pub, pub * 2)
}
