# reg-bio-2 pin (jury request 12-score-invariants): the strength clamp is a
# behavior-change path with zero prior corpus coverage — this differential
# case pins the saturation in BOTH engines. strength 2.0 clamps to 1.0 at
# parse (note, not error), so a clamped edge and a strength-1.0 edge are
# bit-identical; influence follows the Hill dose-response
# strength x p^n/(p^n + t^n) and stays within the physical range.
regulate {
    hot activates sat strength 2.0 threshold 0.2
    warm activates norm strength 1.0 threshold 0.2
    multi activates two_step strength 0.9 threshold 0.2
}
gene sat() { return "sat-ran" }
gene norm() { return "norm-ran" }
gene two_step() { return "two-ran" }
frame proof {
    grn_fire("hot")
    grn_fire("warm")
    grn_fire("multi")
    let s = grn_state()
    let full = 1.0 / (1.0 + 0.2 * 0.2)
    assert(abs(s.sat - full) < 1e-12, "strength 2.0 clamps to 1.0: same Hill influence as strength 1.0")
    assert(abs(s.norm - full) < 1e-12, "strength 1.0 unchanged (legacy bit-identical)")
    assert(abs(s.sat - s.norm) < 1e-15, "the clamp makes 2.0 and 1.0 EXACTLY equivalent")
    let nine = 0.9 * full
    assert(abs(s.two_step - nine) < 1e-12, "strength 0.9 influence = 0.9 x Hill(0.2)")
    assert(s.sat <= 1.0 and s.norm <= 1.0 and s.two_step <= 1.0, "no level exceeds the physical ceiling")
}
main {
    grn_fire("hot")
    grn_fire("multi")
    let s = grn_state()
    promote("saturated: {s.sat}")
    promote("ninety: {s.two_step}")
}
