# graph differential, deterministic graph ops, byte-identical both engines
use std/graph;
let g = graph.graph_new()
let d0 = graph.graph_add_node(g, "lac")
let d1 = graph.graph_add_node(d0, "lacZ")
let d2 = graph.graph_add_node(d1, "lacY")
let d3 = graph.graph_add_node(d2, "lacI")
let d4 = graph.graph_add_node(d3, "lacA")
let dag = graph.graph_add_edge(d4, "lac", "lacZ")
dag = graph.graph_add_edge(dag, "lac", "lacI")
dag = graph.graph_add_edge(dag, "lacZ", "lacY")
dag = graph.graph_add_edge(dag, "lacI", "lacZ")
dag = graph.graph_add_edge(dag, "lacY", "lacA")
print("dag: {dag}")
print("nodes: {graph.graph_nodes(dag)}")
let nb = graph.graph_neighbors(dag, "lac")
print("neighbors: {nb}")
print("edges: {graph.graph_edges(dag)}")
let cnt = [graph.graph_node_count(dag), graph.graph_edge_count(dag)]
print("counts: {cnt}")
let w1 = graph.graph_weight(dag, "lacI", "lacZ")
let w2 = graph.graph_weight(dag, "lacZ", "lacI")
print("weight: {w1} missing: {w2}")
let b1 = graph.graph_bfs(dag, "lac")
let b2 = graph.graph_dfs(dag, "lac")
let b3 = graph.graph_bfs(dag, "ghost")
print("bfs: {b1}")
print("dfs: {b2}")
print("bfs ghost: {b3}")
let tp = graph.graph_topo(dag)
print("topo: {tp}")
let c0 = graph.graph_add_edge(graph.graph_new(), "b", "c")
let c1 = graph.graph_add_edge(c0, "c", "a")
let cyc = graph.graph_add_edge(c1, "a", "b")
let tc = graph.graph_topo(cyc)
print("topo cycle: {tc}")
let sl = graph.graph_add_edge(graph.graph_new(), "x", "x")
let tsl = graph.graph_topo(sl)
let slhas = graph.graph_has_edge(sl, "x", "x")
print("self loop topo: {tsl} has: {slhas}")
let p1 = graph.graph_shortest_path(dag, "lac", "lacA")
let p2 = graph.graph_shortest_path(dag, "lacA", "lac")
let p3 = graph.graph_shortest_path(dag, "lac", "lac")
print("path: {p1}")
print("path back: {p2}")
print("path self: {p3}")
let r1 = graph.graph_reachable(dag, "lac", "lacA")
let r2 = graph.graph_reachable(dag, "lacA", "lac")
print("reach: {r1} {r2}")
let rn = graph.graph_remove_node(dag, "lacI")
print("removed: {graph.graph_edges(rn)}")
let re = graph.graph_remove_edge(dag, "lac", "lacI")
let ec = graph.graph_edge_count(re)
let reh = graph.graph_has_edge(re, "lac", "lacI")
print("edge removed: {ec} {reh}")
let kept = [graph.graph_node_count(dag), graph.graph_edge_count(dag)]
print("dag intact: {kept}")
let m0 = graph.graph_add_node(graph.graph_new(), "a")
let ma = graph.graph_add_node(m0, "b")
let mb = graph.graph_add_node(ma, "c")
let mc = graph.graph_add_node(mb, "d")
let m1 = graph.graph_add_edge(graph.graph_add_edge(mc, "a", "b", 4), "b", "a", 4)
m1 = graph.graph_add_edge(graph.graph_add_edge(m1, "a", "c", 1), "c", "a", 1)
m1 = graph.graph_add_edge(graph.graph_add_edge(m1, "b", "c", 2), "c", "b", 2)
m1 = graph.graph_add_edge(graph.graph_add_edge(m1, "b", "d", 5), "d", "b", 5)
m1 = graph.graph_add_edge(graph.graph_add_edge(m1, "c", "d", 8), "d", "c", 8)
let mst1 = graph.graph_mst_weight(m1)
print("mst: {mst1}")
let mst2 = graph.graph_mst_weight(m1, gene (x, y) => x > y)
print("mst max: {mst2}")
let mst3 = graph.graph_mst_weight(g)
print("mst empty: {mst3}")
let p9 = graph.graph_add_node(graph.graph_new(), "p")
let disc = graph.graph_add_node(p9, "q")
let mst4 = graph.graph_mst_weight(disc)
print("mst disconnected: {mst4}")
stress {
    graph.graph_add_node(g, 7)
} rescue (e) {
    print("ann: {e.kind} {e.message}")
}
stress {
    graph.graph_add_edge(g, "a", "b", "heavy")
} rescue (e) {
    print("ann: {e.kind} {e.message}")
}
