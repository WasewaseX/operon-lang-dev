# Z-125 (#125 headline): a trailing binary operator continues the
# expression onto the next line — the parser used to nullify the operand
# (`1 +\n2` parsed as 1 + null, and `2` leaked into a stray statement).
# Byte-identical on both engines and the oracle.
let x = 1 +
2
print(x)
let y = 10 -
3
print(y)
let z = 2 **
3
print(z)
let w = 1.5 *
4
print(w)
print(1 ==
1)
print(true and
false)
print(false or
true)
print(7 //
2)
print(1 <<
3)
print(5 >
4)
print(2 ??
0)
print(1 +
2 +
3)
print("done")
