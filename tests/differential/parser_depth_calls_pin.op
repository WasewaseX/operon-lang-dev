# differential: parse_postfix call arms share the 4096 depth budget
# (#111): nested-call source used to ABORT the process (stack
# overflow, SIGABRT-class) far below the documented cap. A 4000-deep
# chain must still parse AND evaluate; a 5000-deep chain truncates
# deterministically (f2() null-fills its args, null+null is a
# catchable unfolded stress -> the rescue arm prints, rc stays 0).
# Timestamp-free lines only.
gene f(x) { return x }
gene f2(x, y) { return x + y }
