# differential: std/path: every gene over a fixed input grid, byte-identical
# on both engines. Pure lexical program: no proof frame, no I/O, no grants.
# Covers happy paths and the documented edges: empty strings, trailing and
# doubled separators, hidden dotfiles, ".." chains, root forms.
use std/path as p

print("== join ==")
print(p.join("a", "b"))
print(p.join("a/", "b"))
print(p.join("a//", "b"))
print(p.join("a", "/b"))
print(p.join("a/", "/b"))
print(p.join("", "b"))
print(p.join("", ""))
print(p.join("a", ""))
print(p.join("a/", ""))
print(p.join("/", "b"))
print(p.join("/", ""))
print(p.join("///", "b"))
print(p.join("a", "b/"))
print(p.join("std", "path.op"))

print("== split ==")
print(p.split("a/b/c"))
print(p.split(""))
print(p.split("/"))
print(p.split("//a//b//"))
print(p.split("./a"))
print(p.split("///"))

print("== base ==")
print(p.base("a/b.txt"))
print(p.base("b"))
print(p.base("/x"))
print(p.base("a/b/"))
print(p.base("/"))
print(p.base(""))
print(p.base("a//b"))

print("== dir ==")
print(p.dir("a/b"))
print(p.dir("a/b/c"))
print(p.dir("b"))
print(p.dir("/b"))
print(p.dir("/"))
print(p.dir(""))
print(p.dir("a//b"))
print(p.dir("a/b/"))
print(p.dir("///"))

print("== ext ==")
print(p.ext("a.txt"))
print(p.ext("a.tar.gz"))
print(p.ext("a"))
print(p.ext(".oprc"))
print(p.ext(".oprc.bak"))
print(p.ext("/x/.gitignore"))
print(p.ext("a.b/c"))
print(p.ext("a."))
print(p.ext("dir.x/name"))
print(p.ext(""))
print(p.ext("x/"))

print("== is_abs ==")
print(p.is_abs("/a/b"))
print(p.is_abs("/"))
print(p.is_abs("a/b"))
print(p.is_abs(""))
print(p.is_abs("./x"))

print("== norm ==")
print(p.norm("a//b"))
print(p.norm("./a/./b/."))
print(p.norm("a/b/../c"))
print(p.norm("/a/./b/../c"))
print(p.norm("/.."))
print(p.norm("/../../a"))
print(p.norm("../a"))
print(p.norm("a/../../b"))
print(p.norm("a/b/../../c"))
print(p.norm("/a/b/../../../c"))
print(p.norm("a/.."))
print(p.norm(""))
print(p.norm("/"))
print(p.norm("//"))
print(p.norm("a/b/"))

print("== composed ==")
print(p.norm(p.join("std", "..")))
print(p.join(p.dir("a/b/c.op"), p.base("a/b/c.op")))
print(p.join(p.dir("a/b/"), p.base("a/b/")))
print(p.norm(p.norm("/a/./b/..")))
print(p.ext(p.join("docs", "read.me.op")))
print(p.base(p.norm("a//b/./")))
print("path_std differential complete")
