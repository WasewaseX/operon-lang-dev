# differential: std/csv, quote-aware CSV parsing and serialization
use std/csv as csv

frame proof {
    # escaping: only when needed; inner quotes doubled
    assert(csv.csv_escape("plain", ",") == "plain")
    assert(csv.csv_escape("a,b", ",") == "\"a,b\"")
    assert(csv.csv_escape("say \"hi\"", ",") == "\"say \"\"hi\"\"\"")
    assert(csv.csv_escape("line\nbreak", ",") == "\"line\nbreak\"")
    assert(csv.csv_escape("a|b", "|") == "\"a|b\"")

    # row serialization round shape
    assert(csv.csv_row(["a", "b,c", "d"], ",") == "a,\"b,c\",d")
    assert(csv.csv_row([], ",") == "")
    assert(csv.csv_row([1, 2], ",") == "1,2")

    # single line: plain, quoted, doubled quotes, trailing empty field
    assert(csv.csv_parse_line("1,2,3", ",") == ["1", "2", "3"])
    assert(csv.csv_parse_line("1,\"x,y\",3", ",") == ["1", "x,y", "3"])
    assert(csv.csv_parse_line("1,\"x\"\"y\",3", ",") == ["1", "x\"y", "3"])
    assert(csv.csv_parse_line("a,b,", ",") == ["a", "b", ""])
    assert(csv.csv_parse_line("", ",") == [])

    # document: quoted separators, CRLF endings (chr(13): \r is not an escape), quoted newline field
    let crlf = chr(13) + "\n"
    let doc = "name,age" + crlf + "\"Smith, John\",42" + crlf + "Li,31" + crlf
    assert(csv.csv_parse(doc, ",") == [["name", "age"], ["Smith, John", "42"], ["Li", "31"]])
    let ml = "a,\"x\ny\",b\nc,d,e\n"
    assert(csv.csv_parse(ml, ",") == [["a", "x\ny", "b"], ["c", "d", "e"]])
    assert(csv.csv_parse("", ",") == [])

    # records: header-keyed maps
    let recs = csv.csv_records("name,age\nAda,36\nLin,28\n", ",")
    assert(len(recs) == 2)
    assert(recs[0]["name"] == "Ada" and recs[0]["age"] == "36")
    assert(recs[1]["name"] == "Lin")
    assert(csv.csv_records("onlyheader\n", ",") == [])

    # column extraction, incl. missing column
    assert(csv.csv_column("name,age\nAda,36\nLin,28\n", ",", "age") == ["36", "28"])
    assert(csv.csv_column("name,age\nAda,36\n", ",", "nope") == [])
    assert(csv.csv_column("h\n", ",", "h") == [])

    # custom separator + field counting
    assert(csv.csv_parse_line("a;b;c", ";") == ["a", "b", "c"])
    assert(csv.csv_count_fields("1,2,3", ",") == 3)
    assert(csv.csv_count_fields("1,\"a,b\"", ",") == 2)

    # ---- fast path <-> machine equivalence (quote-free documents route
    # through the bulk split path; every assert here has a quoted twin
    # above or forces one path explicitly via the shape dispatch) ----
    # trailing-newline rule: no final empty row, middle empties survive
    assert(csv.csv_parse("a\n\nb\n", ",") == [["a"], [""], ["b"]])
    assert(csv.csv_parse("a\nb", ",") == [["a"], ["b"]])
    assert(csv.csv_parse("\n", ",") == [[""]])
    assert(csv.csv_parse(chr(13), ",") == [])
    assert(csv.csv_parse("", ",") == [])
    # trailing empty field survives, final trailing newline does not add a row
    assert(csv.csv_parse("a,\n", ",") == [["a", ""]])
    assert(csv.csv_parse(",\n", ",") == [["", ""]])
    # CR is swallowed anywhere outside quotes, not just CRLF pairs
    # (\r is NOT an escape in source: CR arrives via chr(13))
    assert(csv.csv_parse("a" + chr(13) + "b\n", ",") == [["ab"]])
    assert(csv.csv_parse("a" + chr(13) + "\nb" + chr(13) + "\n", ",") == [["a"], ["b"]])
    # separator equal to a CR-adjacent char, and sep == "\n"
    assert(csv.csv_parse("a" + chr(13) + "b", "r") == [["ab"]])
    assert(csv.csv_parse("arb", "r") == [["a", "b"]])
    # sep == "\n" routes to the machine (#106 routing law): the machine's
    # sep arm precedes the newline row-flush, so newlines flush FIELDS
    assert(csv.csv_parse("a\nb\n", "\n") == [["a", "b", ""]])
    assert(csv.csv_parse("a\nb", "\n") == [["a", "b"]])
    # multi-char separator: never matches a char, so each LINE is one field
    # (rows still break at newlines — machine semantics, fast path falls through)
    assert(csv.csv_parse("a,b\nc,d", ",,") == [["a,b"], ["c,d"]])
    # quote anywhere in the document routes to the machine: identical output
    assert(csv.csv_parse("a,\"b\nc\",d\ne,f\n", ",") == [["a", "b\nc", "d"], ["e", "f"]])
    assert(csv.csv_parse("\"a\"\n", ",") == [["a"]])
    assert(csv.csv_parse("a,\"\"\"q\"\"\"\n", ",") == [["a", "\"q\""]])
    # both paths agree when the same rows are re-parsed through csv_records
    assert(len(csv.csv_records("x,y\n1,2\n3,4\n", ",")) == 2)

    # ---- hybrid vs pure-machine equivalence on the tricky corners ----
    assert(csv.csv_parse("a,\"b\nc\",d\ne,f\n", ",") == csv.csv_parse_machine("a,\"b\nc\",d\ne,f\n", ","))
    assert(csv.csv_parse("\"x\ny\nz\",2\n3,4\n", ",") == csv.csv_parse_machine("\"x\ny\nz\",2\n3,4\n", ","))
    assert(csv.csv_parse("\"unterminated\nline", ",") == csv.csv_parse_machine("\"unterminated\nline", ","))
    assert(csv.csv_parse("\"ends with nl\n\"\n", ",") == csv.csv_parse_machine("\"ends with nl\n\"\n", ","))
    assert(csv.csv_parse("\"a\"\"b\",c\n", ",") == csv.csv_parse_machine("\"a\"\"b\",c\n", ","))
    assert(csv.csv_parse("ab\"cd,ef\n", ",") == csv.csv_parse_machine("ab\"cd,ef\n", ","))
    assert(csv.csv_parse("a,\"b\" ,c\n", ",") == csv.csv_parse_machine("a,\"b\" ,c\n", ","))
    assert(csv.csv_parse("\"a,b\",\",\",,\n", ",") == csv.csv_parse_machine("\"a,b\",\",\",,\n", ","))
    assert(csv.csv_parse("a" + chr(13) + "\n\"b" + chr(13) + "c\"\n", ",") == csv.csv_parse_machine("a" + chr(13) + "\n\"b" + chr(13) + "c\"\n", ","))
    assert(csv.csv_parse("\n\n\"\n\"\n\n", ",") == csv.csv_parse_machine("\n\n\"\n\"\n\n", ","))
    assert(csv.csv_parse("a\r\nb\r\n", ",") == csv.csv_parse_machine("a\r\nb\r\n", ","))
    assert(csv.csv_parse("say \"\"hi\"\" there\n", ",") == csv.csv_parse_machine("say \"\"hi\"\" there\n", ","))
    assert(csv.csv_parse("\"multi\nline\nfields\",x\ny,z\n", ",") == csv.csv_parse_machine("\"multi\nline\nfields\",x\ny,z\n", ","))
    assert(csv.csv_parse("plain,line\nalso,plain\n", ",") == csv.csv_parse_machine("plain,line\nalso,plain\n", ","))

    # ---- separator-collusion classes route to the machine (#106) ----
    # The machine's arm order is quote-open -> sep -> newline -> CR-swallow;
    # a sep that IS one of those characters has machine semantics the fast
    # path cannot mirror (pre-fix the hybrid returned [["a\"b"]] / [["abc"]]
    # for the first two rows — the sep was reclassified or erased).
    assert(csv.csv_parse("a\"b", "\"") == [["a", "b"]])
    assert(csv.csv_parse("a\"b", "\"") == csv.csv_parse_machine("a\"b", "\""))
    let cr = chr(13)
    assert(csv.csv_parse("a" + cr + cr + "b" + cr + cr + "c", cr) == [["a", "", "b", "", "c"]])
    assert(csv.csv_parse("a" + cr + "b" + cr + "c", cr) == [["a", "b", "c"]])
    assert(csv.csv_parse("a" + cr + cr + "b" + cr + cr + "c", cr) == csv.csv_parse_machine("a" + cr + cr + "b" + cr + cr + "c", cr))
    assert(csv.csv_parse("a\nb\n", "\n") == csv.csv_parse_machine("a\nb\n", "\n"))

    # ---- csv_escape CR law (#106): CR-bearing fields are quoted, and the
    # round trip preserves the CR (the first cut tested f.contains("\r")
    # — "\r" is the two-char literal backslash-r, never a real CR) ----
    assert(csv.csv_escape("a" + cr + "b", ",") == "\"a" + cr + "b\"")
    assert(csv.csv_escape("plain", ",") == "plain")
    assert(csv.csv_row(["a" + cr + "b", "c"], ",") == "\"a" + cr + "b\",c")
    assert(csv.csv_parse(csv.csv_row(["a" + cr + "b", "c"], ","), ",") == [["a" + cr + "b", "c"]])
    # CR inside a quoted field survives the machine too (data, not CRLF)
    assert(csv.csv_parse("\"a" + cr + "b\",c", ",") == [["a" + cr + "b", "c"]])
}
main {
    promote("std/csv: ok")
}
