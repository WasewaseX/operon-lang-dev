# L1a: iteration builtins — enumerate zip sorted reversed any all first last
# take drop unique flatten chunk. All deterministic; oracle mirrors each.
# Wrong-type inputs → Null + note (never a crash).
frame proof {
    let l = [10, 20, 30, 40]
    assert(enumerate([7, 8])[0] == [0, 7])
    assert(enumerate("ab")[1] == [1, "b"])
    assert(zip([1, 2, 3], ["a", "b"]) == [[1, "a"], [2, "b"]])
    assert(sorted([3, 1, 2]) == [1, 2, 3])
    assert(sorted([3, 1, 2], gene (u, v) => u > v) == [3, 2, 1])
    assert(sorted(l) == l)
    assert(reversed([1, 2]) == [2, 1])
    assert(any([0, 1]) == true and any([0, 0]) == false)
    assert(all([1, 2]) == true and all([1, 0]) == false)
    assert(any([]) == false and all([]) == true)
    assert(first([9, 8]) == 9)
    assert(last([9, 8]) == 8)
    assert(first([]) == null and last([]) == null)
    assert(first("abc") == "a" and last("abc") == "c")
    assert(take(l, 2) == [10, 20])
    assert(take(l, 99) == l)
    assert(take(l, 0) == [])
    assert(drop(l, 2) == [30, 40])
    assert(drop(l, 99) == [])
    assert(unique([1, 1, 2, 2, 3]) == [1, 2, 3])
    assert(unique([1, 2]) == [1, 2])
    assert(flatten([[1, 2], [3], 4]) == [1, 2, 3, 4])
    assert(flatten([]) == [])
    assert(chunk(l, 3) == [[10, 20, 30], [40]])
    assert(chunk(l, 1) == [[10], [20], [30], [40]])
    assert(chunk(l, 9) == [l])
    assert(sorted(["b", "a"]) == ["a", "b"])
    assert(zip([], [1]) == [])
}
main {
    promote(enumerate("ab"))
    promote(zip([1, 2, 3], ["a", "b"]))
    promote(sorted([3, 1, 2]))
    promote(sorted([30, 10, 20], gene (u, v) => u > v))
    promote(reversed([1, 2, 3]))
    promote(any([0, 1]))
    promote(all([1, 2, 0]))
    promote(first([]))
    promote(last([9, 8]))
    promote(take([10, 20, 30], 2))
    promote(drop([10, 20, 30], 2))
    promote(unique([1, 1, 2, 2, 3]))
    promote(flatten([[1, 2], [3], 4]))
    promote(chunk([10, 20, 30, 40], 3))
    promote(take("abc", 2))
    promote(drop("abc", 1))
    promote(sorted(42))
    promote(zip([1], 2))
}
