# tests/path_std.op: std/path proof corpus.
#
# Every gene over happy paths and edge cases: empty strings, trailing
# separators, hidden dotfiles, ".." chains, doubled separators, plus
# determinism and composition pins. std/path is pure (no grants needed);
# the program section below exercises every gene once outside the frame.
use std/path as p

print("join:", p.join("std", "path.op"), "|", p.join("std/", "/etc/op"), "|", p.join("/", "b"))
print("split:", p.split("/a//b/"))
print("base/ext:", p.base("a/b/c.op"), p.ext("a/b/c.op"))
print("dir:", p.dir("a/b/c.op"), "| is_abs:", p.is_abs("a/b"), p.is_abs("/a"))
print("norm:", p.norm("a/./b/../c"))

frame proof {
    # ---- join: simple, separators, empty parts, absolute replacement
    assert(p.join("a", "b") == "a/b", "join simple")
    assert(p.join("a/", "b") == "a/b", "join trims one trailing sep")
    assert(p.join("a//", "b") == "a/b", "join trims all trailing seps")
    assert(p.join("a", "/b") == "/b", "join absolute b replaces a")
    assert(p.join("a/", "/b") == "/b", "join absolute b wins over trailing")
    assert(p.join("", "b") == "b", "join empty a contributes nothing")
    assert(p.join("", "") == "", "join both empty")
    assert(p.join("a", "") == "a", "join empty b")
    assert(p.join("a/", "") == "a", "join trailing sep + empty b")
    assert(p.join("/", "b") == "/b", "join root a")
    assert(p.join("///", "b") == "/b", "join all-separator a is root")
    assert(p.join("/", "") == "/", "join root + empty b stays root")
    assert(p.join("a", "b/") == "a/b/", "join keeps b trailing sep")

    # ---- split: non-empty segments only
    assert(p.split("a/b/c") == ["a", "b", "c"], "split simple")
    assert(p.split("") == [], "split empty")
    assert(p.split("/") == [], "split root")
    assert(p.split("//a//b//") == ["a", "b"], "split drops empty segments")
    assert(p.split("./a") == [".", "a"], "split keeps dot segments (norm removes them)")

    # ---- base: final segment, trailing-slash paths have none
    assert(p.base("a/b.txt") == "b.txt", "base final segment")
    assert(p.base("b") == "b", "base single segment")
    assert(p.base("/x") == "x", "base under root")
    assert(p.base("a/b/") == "", "base trailing slash")
    assert(p.base("/") == "", "base root")
    assert(p.base("") == "", "base empty")
    assert(p.base("a//b") == "b", "base after doubled sep")

    # ---- dir: before the last segment, "" if none, "/" for root
    assert(p.dir("a/b") == "a", "dir simple")
    assert(p.dir("a/b/c") == "a/b", "dir nested")
    assert(p.dir("b") == "", "dir no separator")
    assert(p.dir("/b") == "/", "dir directly under root")
    assert(p.dir("/") == "/", "dir root")
    assert(p.dir("") == "", "dir empty")
    assert(p.dir("a//b") == "a", "dir skips doubled sep")
    assert(p.dir("a/b/") == "a/b", "dir trailing sep lands in dir")
    assert(p.dir("///") == "/", "dir all separators is root")

    # ---- ext: after the last dot of the base, no leading-dot extension
    assert(p.ext("a.txt") == "txt", "ext simple")
    assert(p.ext("a.tar.gz") == "gz", "ext last dot wins")
    assert(p.ext("a") == "", "ext no dot")
    assert(p.ext(".oprc") == "", "ext hidden dotfile has none")
    assert(p.ext(".oprc.bak") == "bak", "ext dotfile can still carry one")
    assert(p.ext("/x/.gitignore") == "", "ext hidden dotfile under root")
    assert(p.ext("a.b/c") == "", "ext ignores dots in dir names")
    assert(p.ext("a.") == "", "ext trailing dot is empty")
    assert(p.ext("dir.x/name") == "", "ext base only")
    assert(p.ext("") == "", "ext empty")

    # ---- is_abs: leading slash only
    assert(p.is_abs("/a/b") and p.is_abs("/"), "is_abs true")
    assert(!p.is_abs("a/b") and !p.is_abs("") and !p.is_abs("./x"), "is_abs false")

    # ---- norm: lexical collapse only, ".." never crosses a relative top
    assert(p.norm("a//b") == "a/b", "norm collapses doubled seps")
    assert(p.norm("./a/./b/.") == "a/b", "norm drops dot segments")
    assert(p.norm("a/b/../c") == "a/c", "norm cancels seg/.. pairs")
    assert(p.norm("/a/./b/../c") == "/a/c", "norm absolute keeps root")
    assert(p.norm("/..") == "/", "norm .. at absolute root")
    assert(p.norm("/../../a") == "/a", "norm .. absorbed at root")
    assert(p.norm("../a") == "../a", "norm keeps leading relative ..")
    assert(p.norm("a/../../b") == "../b", "norm .. past relative top stays")
    assert(p.norm("a/b/../../c") == "c", "norm chain of cancellations")
    assert(p.norm("/a/b/../../../c") == "/c", "norm absolute chain")
    assert(p.norm("a/..") == "", "norm relative collapse to empty")
    assert(p.norm("") == "", "norm empty")
    assert(p.norm("/") == "/", "norm root")
    assert(p.norm("//") == "/", "norm doubled root")
    assert(p.norm("a/b/") == "a/b", "norm drops trailing sep")

    # ---- determinism: repeats agree and the module stays pure
    let once = p.norm("a/./b//..")
    let twice = p.norm("a/./b//..")
    assert(once == twice and once == "a", "norm repeat is deterministic")
    assert(p.join("a", "b") == p.join("a", "b"), "join repeat is deterministic")
    assert(p.split("a/b") == p.split("a/b"), "split repeat is deterministic")

    # ---- composition: the genes compose into path algebra
    assert(p.join(p.dir("a/b/c.op"), p.base("a/b/c.op")) == "a/b/c.op", "dir+base roundtrip")
    assert(p.join(p.dir("a/b/"), p.base("a/b/")) == "a/b", "trailing-slash roundtrip keeps dir")
    assert(p.norm(p.join("std", "..")) == "", "join+norm compose")
    assert(p.norm(p.norm("/a/./b/..")) == p.norm("/a/./b/.."), "norm is idempotent")
    assert(p.is_abs(p.join("/a", "b")) and !p.is_abs(p.join("a", "b")), "abs-ness follows a unless b replaces")
    assert(p.ext(p.join("docs", "read.me.op")) == "op", "ext over join")
    assert(p.base(p.norm("a//b/./")) == "b", "base over norm")
}
