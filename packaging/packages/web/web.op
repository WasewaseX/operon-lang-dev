# web - an Operon registry package.
#
# Helpers for the core serve() / recv_request() / send_response() loop plus
# the data shapes a web app keeps rebuilding by hand: escaped HTML, response
# maps, an exact-match routes table, cookies. Depends on the http package
# (^1.0) for the client side of the same story.

gene escape_html(s) {
    # the five characters that matter, & first - the whole XSS class starts
    # with getting this order wrong
    let out = s;
    out = out.replace("&", "&amp;");
    out = out.replace("<", "&lt;");
    out = out.replace(">", "&gt;");
    out = out.replace("\"", "&quot;");
    out = out.replace("'", "&#39;");
    return out;
}

gene response(status, content_type, body) {
    # the shape core send_response() consumes
    return { "status": status, "content_type": content_type, "body": body };
}

gene html_response(body) {
    return response(200, "text/html; charset=utf-8", body);
}

gene json_response(v) {
    return response(200, "application/json", json_str(v));
}

gene not_found(path) {
    return response(404, "text/plain; charset=utf-8", "not found: " + path);
}

gene route(method, path, routes) {
    # routes: map of "METHOD /path" -> handler gene (takes the path, returns
    # a response map). Exact match only; prefix/catch-all routing is
    # intentionally NOT implemented - exact routing is auditable, prefix
    # routing is how path-confusion bugs start.
    let key = method + " " + path;
    stress {
        return routes[key](path);
    } rescue (e) {
        return not_found(path);
    }
}

gene page(title, body_html) {
    # minimal page shell - escaped title, trusted body (the caller escapes
    # their own interpolations with escape_html; that boundary stays explicit)
    return "<!doctype html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<title>"
        + escape_html(title)
        + "</title>\n</head>\n<body>\n"
        + body_html
        + "\n</body>\n</html>\n";
}

gene set_cookie(name, value) {
    # a Set-Cookie header value; HttpOnly always on, SameSite=Lax default -
    # safe defaults first, footguns opt-in
    return name + "=" + value + "; Path=/; HttpOnly; SameSite=Lax";
}

gene parse_cookies(header) {
    # "a=1; b=2" -> {"a": "1", "b": "2"}
    let out = {};
    if header == "" {
        return out;
    }
    for part in header.split("; ") {
        let pair = part.split("=");
        if pair.len() == 2 {
            out[pair[0]] = pair[1];
        }
    }
    return out;
}
