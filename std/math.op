# std/math — self-hosted numeric utilities on top of the core math builtins.

gene clamp(x, lo, hi) {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

gene lerp(a, b, t) {
    return a + (b - a) * t
}

gene mean(xs) {
    if len(xs) == 0 { return 0.0 }
    return sum(xs) / len(xs)
}

gene variance(xs) {
    if len(xs) == 0 { return 0.0 }
    let m = mean(xs)
    let acc = 0.0
    for x in xs {
        acc = acc + (x - m) * (x - m)
    }
    return acc / len(xs)
}

gene stddev(xs) {
    return sqrt(variance(xs))
}

gene median(xs) {
    let n = len(xs)
    if n == 0 { return 0.0 }
    let sorted = xs.sort(gene (a, b) => a < b)
    if n % 2 == 1 {
        return sorted[n // 2]
    }
    return (sorted[n // 2 - 1] + sorted[n // 2]) / 2.0
}

gene hill(x, k, n) {
    # Hill function: saturation dose-response (n = cooperativity)
    let xn = x ** n
    let kn = k ** n
    return xn / (xn + kn)
}

gene sigmoid(x) {
    return 1.0 / (1.0 + 2.718281828459045 ** (0.0 - x))
}

gene digits(n) {
    let out = []
    let v = abs(n)
    if v == 0 { return [0] }
    while v > 0 {
        insert(out, 0, v % 10)
        v = v // 10
    }
    return out
}

# --- everyday numeric helpers (B2) -------------------------------------------

gene round(x) {
    # half away from zero: round(2.5) == 3, round(-2.5) == -3
    if x >= 0 {
        return floor(x + 0.5)
    }
    return ceil(x - 0.5)
}

gene round_to(x, n) {
    # round to n decimals, returns a number (not a string — see fmt.fixed)
    let sc = 10 ** n
    return round(x * sc) / sc
}

gene sign(x) {
    if x > 0 {
        return 1
    }
    if x < 0 {
        return 0 - 1
    }
    return 0
}

gene gcd(a, b) {
    # greatest common divisor, always >= 0 (inputs absolute-valued)
    a = abs(a)
    b = abs(b)
    while b != 0 {
        let t = b
        b = a % b
        a = t
    }
    return a
}

gene lcm(a, b) {
    # least common multiple; lcm(0, x) == 0
    if a == 0 or b == 0 {
        return 0
    }
    return abs(a * b) // gcd(a, b)
}

gene factorial(n) {
    # n! for n >= 0 (factorial of a negative returns 1 — call it a contract)
    let out = 1
    let i = 2
    while i <= n {
        out = out * i
        i = i + 1
    }
    return out
}

gene isqrt(n) {
    # integer square root: largest m with m*m <= n (binary search)
    if n < 2 {
        return n
    }
    let lo = 1
    let hi = n
    while lo < hi {
        let mid = (lo + hi + 1) // 2
        if mid * mid <= n {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    return lo
}

gene divmod(a, b) {
    # [quotient, remainder] in one call (floored division semantics)
    return [a // b, a % b]
}

gene wrap(x, lo, hi) {
    # cycle x into [lo, hi): wrap(370, 0, 360) == 10 (also handles negatives)
    let span = hi - lo
    if span <= 0 {
        return lo
    }
    let shift = (x - lo) % span
    if shift < 0 {
        shift = shift + span
    }
    return lo + shift
}
