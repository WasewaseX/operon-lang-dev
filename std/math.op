# std/math, self-hosted numeric utilities on top of the core math builtins.

gene clamp(x, lo, hi) {
    if x < lo { return lo }
    if x > hi { return hi }
    return x
}

gene lerp(a, b, t) {
    return a + (b - a) * t
}

gene mean(xs) {
    if len(xs) == 0 { return 0.0 }
    return sum(xs) / len(xs)
}

gene variance(xs) {
    if len(xs) == 0 { return 0.0 }
    let m = mean(xs)
    let acc = 0.0
    for x in xs {
        acc = acc + (x - m) * (x - m)
    }
    return acc / len(xs)
}

gene stddev(xs) {
    return sqrt(variance(xs))
}

gene median(xs) {
    let n = len(xs)
    if n == 0 { return 0.0 }
    let sorted = xs.sort(gene (a, b) => a < b)
    if n % 2 == 1 {
        return sorted[n // 2]
    }
    return (sorted[n // 2 - 1] + sorted[n // 2]) / 2.0
}

gene hill(x, k, n) {
    # Hill function: saturation dose-response (n = cooperativity)
    let xn = x ** n
    let kn = k ** n
    return xn / (xn + kn)
}

gene sigmoid(x) {
    return 1.0 / (1.0 + 2.718281828459045 ** (0.0 - x))
}

gene digits(n) {
    # digit list of |n|, overflow-safe (issue #133): works in negative space
    # so abs(i64::MIN) is never taken — abs overflows on exactly one input,
    # and that input's digit count is perfectly well-defined
    let out = []
    let v = n
    if v > 0 {
        v = 0 - v
    }
    if v == 0 {
        return [0]
    }
    while v < 0 {
        # floored % with a negative divisor lands in (-10..0], so
        # 0 - (v % -10) is |v| mod 10; (v + d) is an exact multiple of 10,
        # which keeps the // below exact and v representable for every i64
        let d = 0 - (v % (0 - 10))
        insert(out, 0, d)
        v = (v + d) // 10
    }
    return out
}

# --- everyday numeric helpers (B2) -------------------------------------------

gene round(x) {
    # half away from zero: round(2.5) == 3, round(-2.5) == -3
    # FP-artifact-free (issue #136 row 10): the old floor(x + 0.5) form
    # mis-rounds 0.49999999999999994 — x + 0.5 rounds UP to exactly 1.0 in
    # binary floating point and floor answers 1, while the true value is
    # below the half point and any half-away contract answers 0. The
    # comparison form never adds near the boundary: floor(x) gives the
    # integer band, then x is compared against the EXACT midpoint
    # floor(x) + 0.5 (exactly representable for every in-range band, so no
    # rounding can move x across it). |x| >= 2^52 (or NaN/inf): every
    # finite double is an integer, the band is the value itself.
    if not (x > -4503599627370496.0 and x < 4503599627370496.0) {
        return x
    }
    let fl = floor(x)
    let half = fl + 0.5
    if x > half {
        return fl + 1
    }
    if x < half {
        return fl
    }
    # x is exactly the midpoint: half away from ZERO (2.5 -> 3, -2.5 -> -3)
    if fl >= 0 {
        return fl + 1
    }
    return fl
}

gene round_to(x, n) {
    # round to n decimals, returns a number (not a string, see fmt.fixed)
    # n clamped to 18 (issue #133): 10**19 overflows i64; 18 decimals is the
    # ceiling of this scale-multiply design — documented, not a crash
    if n > 18 {
        n = 18
    }
    let sc = 10 ** n
    return round(x * sc) / sc
}

gene sign(x) {
    if x > 0 {
        return 1
    }
    if x < 0 {
        return 0 - 1
    }
    return 0
}

gene gcd(a, b) {
    # greatest common divisor, always >= 0 (inputs absolute-valued)
    a = abs(a)
    b = abs(b)
    while b != 0 {
        let t = b
        b = a % b
        a = t
    }
    return a
}

gene lcm(a, b) {
    # least common multiple; lcm(0, x) == 0
    # divide FIRST, then multiply (issue #133): a*b overflows long before
    # the true lcm does; (a // gcd(a,b)) * b fits i64 whenever the true
    # lcm fits — the only case a correct lcm can promise
    if a == 0 or b == 0 {
        return 0
    }
    return abs((a // gcd(a, b)) * b)
}

gene factorial(n) {
    # n! for n >= 0 (factorial of a negative returns 1, call it a contract)
    let out = 1
    let i = 2
    while i <= n {
        out = out * i
        i = i + 1
    }
    return out
}

gene isqrt(n) {
    # integer square root: largest m with m*m <= n (binary search)
    # overflow-safe (issue #133): the search is capped at 3037000499 =
    # floor(sqrt(i64::MAX)) — every i64 n has isqrt(n) <= that bound, and
    # below it both mid*mid (<= 9223372030926249001) and (lo+hi+1) cannot
    # overflow, so the naive comparisons stay exact everywhere
    if n < 2 {
        return n
    }
    let lo = 1
    let hi = 3037000499
    if hi > n {
        hi = n
    }
    while lo < hi {
        let mid = (lo + hi + 1) // 2
        if mid * mid <= n {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    return lo
}

gene divmod(a, b) {
    # [quotient, remainder] in one call (floored division semantics)
    return [a // b, a % b]
}

gene wrap(x, lo, hi) {
    # cycle x into [lo, hi): wrap(370, 0, 360) == 10 (also handles negatives)
    let span = hi - lo
    if span <= 0 {
        return lo
    }
    let shift = (x - lo) % span
    if shift < 0 {
        shift = shift + span
    }
    return lo + shift
}
