# std/serialize, the unified serialization front door (W34 stage 1).
#
# One naming surface, one error contract, per-format round-trip guarantees:
#   to_json(v)        -> str            total for the supported value shapes
#   from_json(text)   -> Result        ok(value) | err(message), expected
#                                      failures are values (D-014), never a
#                                      crash and never a silent null
#   to_csv_rows / from_csv_rows        tabular layer over std/csv semantics
#   roundtrip(value, fmt) -> bool      to → from → structural equality
#
# Stage 1 covers the value layer: null / bool / int / float / str / list /
# map, plus Option/Result wrappers (they JSON-wrap as {"ok":…} / {"err":…} /
# null, the D-014 wire shape). Phenotype instances wait for the W04 trait
# hook, `trait Serializable { gene to_map() }` consumed by a format-generic
# `serialize()`, whose shape is frozen in docs/specs/SERIALIZATION.md, so
# downstream code can adopt this module now and keep its calls when the hook
# lands.
#
# Why a dispatcher over the bare json_str/json_parse builtins: exactly one
# place owns the error contract (Result, not a stress across the API line,
# not a silent null), one place pins the round-trip table per type, and one
# migration point when W04 lands the trait hook and stage 2 adds formats.
#
# Round-trip guarantees (value layer, json format):
#   null / bool / int        exact
#   float                    exact for finite values (JSON number text);
#                            non-finite floats serialize as null (RFC 8259
#                            honesty in json_str), those DO NOT round-trip
#                            and roundtrip() reports false for them
#   str                      exact (UTF-8 text)
#   list / map               exact, recursively (structural == equality;
#                            map keys are strings, insertion order is not
#                            part of the JSON wire shape, but JSON objects
#                            re-parse in document order, so == holds)
#   option / result          wire shape {"ok":…}/{"err":…}/null; see the
#                            pinned proof, re-parse does NOT rebuild the
#                            wrapper (a single-key map is indistinguishable
#                            from a map by design: wire fidelity, not tag
#                            fidelity). Use the wrappers' json_str form
#                            when the tag must survive, then rebuild at the
#                            far end with is_ok/has_key.

gene to_json(v) {
    # total: every supported value shape emits valid JSON (RFC 8259);
    # non-finite floats become null inside json_str (SPEC §10).
    return json_str(v)
}

gene from_json(text) {
    # Result-shaped parse: ok(value) | err(message). The underlying builtin
    # raises a catchable `unfolded` Stress on invalid text, stage-1 policy
    # catches it HERE and hands back a value (the caller never writes
    # stress/rescue just to parse a string that might be junk).
    let v = null
    let problem = ""
    stress {
        v = json_parse(str(text))
    } rescue (e) {
        problem = e.message
    }
    if problem != "" {
        return err(problem)
    }
    return ok(v)
}

gene to_csv_rows(rows, sep) {
    # rows: a list of lists (raw cells, any scalar shape, str() coerced).
    # Quoting follows std/csv semantics (RFC-4180 flavored): a cell that
    # contains the separator, a quote, or a newline is quoted; inner quotes
    # double. Written here rather than imported so the dispatcher has ONE
    # dependency surface (the builtins), stage 2 may re-route through
    # std/csv once sibling imports are proven corpus-wide.
    let out = []
    for row in rows {
        let parts = []
        for cell in row {
            let f = str(cell)
            if f.contains(sep) or f.contains("\"") or f.contains("\n") {
                parts.push("\"" + f.replace("\"", "\"\"") + "\"")
            } else {
                parts.push(f)
            }
        }
        out.push(parts.join(sep))
    }
    return out.join("\n")
}

gene from_csv_rows(text, sep) {
    # Result-shaped tabular parse (value layer: scalar cells as strings).
    # Delegates the character-level state machine to std/csv's csv_parse,
    # the one sibling import in this module, because re-implementing a
    # state machine here is exactly the drift W34 exists to prevent.
    use std/csv as csv
    let rows = csv.csv_parse(str(text), sep)
    if rows == null {
        return err("csv parse failed")
    }
    return ok(rows)
}

gene supported_formats() {
    # the stage-1 format inventory; stage 2 grows this list, callers that
    # branch on it stay source-compatible
    return ["json", "csv"]
}

gene roundtrip(value, fmt) {
    # to → from → structural equality. The contract-checker the proofs and
    # the cookbook use: if roundtrip(v, "json") is true, a consumer on the
    # far side receives a value that == the original.
    if fmt == "json" {
        let text = json_str(value)
        let parsed = from_json(text)
        if is_err(parsed) {
            return false
        }
        return unwrap(parsed) == value
    }
    if fmt == "csv" {
        # csv is a row-string layer, not a value-tree format: only a list
        # of lists of scalars is required to round-trip
        if type(value) != "list" {
            return false
        }
        let text = to_csv_rows(value, ",")
        let parsed = from_csv_rows(text, ",")
        if is_err(parsed) {
            return false
        }
        return unwrap(parsed) == value
    }
    return false
}

gene serialize(value, fmt) {
    # the W04 entry point: today format-generic dispatch for the value
    # layer; when the trait hook lands, phenotype instances flow through
    # the same signature (Serializable.to_map() → map → format).
    if fmt == "json" {
        return to_json(value)
    }
    if fmt == "csv" {
        return to_csv_rows(value, ",")
    }
    return err("unsupported format: " + str(fmt))
}

gene deserialize(text, fmt) {
    # mirror of serialize(): Result-shaped, so a bad payload is a value the
    # caller unwraps, the error contract never changes shape
    if fmt == "json" {
        return from_json(text)
    }
    if fmt == "csv" {
        return from_csv_rows(text, ",")
    }
    return err("unsupported format: " + str(fmt))
}
