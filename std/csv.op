# std/csv, CSV-ish parsing and serialization, a pure string layer.
#
# RFC-4180 flavored: fields may be quoted; inside quotes the separator and
# newlines are literal; "" inside a quoted field is one literal quote.
# The separator is a parameter, "csv" also handles TSV ("|", ";", "\t"...).
#
# csv_parse is a character-level state machine, so quoted multi-line fields
# survive; every function here is pure (no fs access, no caps involved).

gene csv_escape(field, sep) {
    # quote a field when needed; double any inner quotes
    let f = str(field)
    if f.contains(sep) or f.contains("\"") or f.contains("\n") {
        return "\"" + f.replace("\"", "\"\"") + "\""
    }
    return f
}

gene csv_row(fields, sep) {
    # serialize one row: ["a", "b,c"] -> a,"b,c"
    # dx-r5 (audit P0-2): parts accumulate in a list, joined once, the
    # concat loop was O(n^2) (each + re-allocated the whole row so far).
    let parts = []
    let i = 0
    for f in fields {
        if i > 0 {
            push(parts, sep)
        }
        push(parts, csv_escape(f, sep))
        i = i + 1
    }
    return parts.join("")
}

gene csv_parse(text, sep) {
    # parse a whole document into rows (list of list of string fields)
    # dx-r5 (audit P0-2): the field buffer accumulates in a list joined once
    # per field, and the document is iterated with `for c in text`, the old
    # form re-allocated the field per character AND sliced per character
    # (measured 3.7 s on a 196 KB document; this form is linear).
    # pending = saw a double-quote inside a quoted field: it either opens an
    # escaped quote (next char is another quote) or closed the field.
    let cr = chr(13)
    let rows = []
    let row = []
    let chars = []
    let inq = false
    let pending = false
    for c in text {
        if pending and c == "\"" {
            push(chars, "\"")
            pending = false
            continue
        }
        if pending {
            pending = false
            inq = false
        } else {
            if inq {
                if c == "\"" {
                    pending = true
                } else {
                    push(chars, c)
                }
                continue
            }
        }
        if c == "\"" and len(chars) == 0 {
            inq = true
        } else {
            if c == sep {
                push(row, chars.join(""))
                chars = []
            } else {
                if c == "\n" {
                    push(row, chars.join(""))
                    chars = []
                    push(rows, row)
                    row = []
                } else {
                    if c == cr {
                        # swallow real carriage returns (CRLF endings)
                    } else {
                        push(chars, c)
                    }
                }
            }
        }
    }
    if len(chars) > 0 or len(row) > 0 {
        push(row, chars.join(""))
        push(rows, row)
    }
    return rows
}

gene csv_parse_line(line, sep) {
    # single-line convenience: first parsed row, or [] for empty input
    let rows = csv_parse(line, sep)
    if len(rows) == 0 {
        return []
    }
    return rows[0]
}

gene csv_records(text, sep) {
    # header row + data rows -> list of maps keyed by the header names
    let rows = csv_parse(text, sep)
    if len(rows) < 2 {
        return []
    }
    let head = rows[0]
    let out = []
    let i = 1
    while i < len(rows) {
        let m = {}
        let c = 0
        for h in head {
            if c < len(rows[i]) {
                m[h] = rows[i][c]
            }
            c = c + 1
        }
        push(out, m)
        i = i + 1
    }
    return out
}

gene csv_column(text, sep, name) {
    # all values of the named column (data rows only)
    let rows = csv_parse(text, sep)
    if len(rows) < 2 {
        return []
    }
    let head = rows[0]
    let ix = 0 - 1
    let c = 0
    for h in head {
        if h == name {
            ix = c
        }
        c = c + 1
    }
    if ix < 0 {
        return []
    }
    let out = []
    let i = 1
    while i < len(rows) {
        if ix < len(rows[i]) {
            push(out, rows[i][ix])
        }
        i = i + 1
    }
    return out
}

gene csv_count_fields(line, sep) {
    # how many fields a single line would produce (quote-aware)
    return len(csv_parse_line(line, sep))
}
