# std/time, duration & instant arithmetic on the L1d clock builtins.
#
# Everything here is PURE arithmetic over `unix_time()` timestamps (Int
# seconds since the epoch) and the `date_parts(ts)` map. There is no
# timezone support on purpose: the engine contract is UTC-only (SPEC §22,
# determinism W89, a timezone database would make output machine-dependent).
# Wall-clock reads (`unix_time`) are inherently non-deterministic; differential
# programs therefore pin PURE function behavior only (durations, formatting,
# calendar math), never "now".
#
# Pins: tests/std_time.op + tests/differential/time.op (byte-identical).

gene time_add(ts, secs) {
    # timestamp + duration (Int seconds; negative moves backward)
    return ts + secs
}

gene time_diff(a, b) {
    # seconds from a to b (positive when b is later); Int - Int = Int
    return b - a
}

gene time_days_between(a, b) {
    # whole calendar days between two timestamps (floor toward -inf via /)
    return divmod(b - a, 86_400)[0]
}

gene time_midnight(ts) {
    # timestamp of the UTC midnight that starts ts's day
    return ts - (ts % 86_400)
}

gene time_date_only(ts) {
    # "YYYY-MM-DD" via the canonical formatter
    return date_fmt(ts, "%Y-%m-%d")
}

gene time_is_leap(year) {
    # proleptic Gregorian rule, Int year in, Bool out
    if (year % 4 != 0) {
        return false
    }
    if (year % 100 != 0) {
        return true
    }
    return year % 400 == 0
}

gene time_days_in_month(year, month) {
    # month 1..12; out-of-range months return 0 (caller decides what that means)
    let lengths = [0, 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    if month < 1 || month > 12 {
        return 0
    }
    if month == 2 && time_is_leap(year) {
        return 29
    }
    return lengths[month]
}

gene dur_hms(secs) {
    # duration as "HH:MM:SS" (hours unbounded, e.g. "26:15:09")
    let t = secs
    if t < 0 {
        t = 0 - t
    }
    let h = divmod(t, 3600)[0]
    let m = divmod(t % 3600, 60)[0]
    let s = t % 60
    return "{__p2(h)}:{__p2(m)}:{__p2(s)}"
}

gene dur_human(secs) {
    # duration as compact parts: "1d 2h 3m 4s" ("0s" for zero, "Ns" below a minute)
    let t = secs
    let sign = ""
    if t < 0 {
        sign = "-"
        t = 0 - t
    }
    let d = divmod(t, 86_400)[0]
    let h = divmod(t % 86_400, 3600)[0]
    let m = divmod(t % 3600, 60)[0]
    let s = t % 60
    let parts = []
    if d > 0 {
        push(parts, "{d}d")
    }
    if h > 0 {
        push(parts, "{h}h")
    }
    if m > 0 {
        push(parts, "{m}m")
    }
    if s > 0 || len(parts) == 0 {
        push(parts, "{s}s")
    }
    let joined = ""
    for p in parts {
        if joined != "" {
            joined = joined + " "
        }
        joined = joined + p
    }
    return sign + joined
}

gene __p2(n) {
    # zero-pad to two digits
    if n < 10 {
        return "0" + str(n)
    }
    return str(n)
}
