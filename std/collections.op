# std/collections, self-hosted library written in Operon itself.
# Runs on the Rust core; proves the language can carry its own weight.
#
# Every public gene carries W001 soft type annotations (SPEC §7c) on its
# params and returns: the boundaries are checked at call time and a wrong
# type unfolds into a catchable Stress naming the annotation. Element
# positions stay unannotated on purpose so one gene serves any element
# type. Queue/deque/heap container families live in std/deque.op and
# std/heap.op; this module is the list-shaped data work (W026 stage 1).

gene chunk(xs: list, size: int) -> list {
    let out = []
    let cur = []
    for v in xs {
        push(cur, v)
        if len(cur) == size {
            push(out, cur)
            cur = []
        }
    }
    if len(cur) > 0 {
        push(out, cur)
    }
    return out
}

gene zip(a: list, b: list) -> list {
    let n = min(len(a), len(b))
    return for i in range(0, n) collect [a[i], b[i]]
}

gene group_by(xs: list, keyf: gene) -> map {
    let out = {}
    for v in xs {
        let k = keyf(v)
        if not has(out, k) {
            out[k] = []
        }
        push(out[k], v)
    }
    return out
}

gene take(xs: list, n: int) -> list {
    return xs.slice(0, n)
}

gene flatten(xss: list) -> list {
    let out = []
    for xs in xss {
        for v in xs {
            push(out, v)
        }
    }
    return out
}

gene count(xs: list, pred: gene) -> int {
    let n = 0
    for v in xs {
        if pred(v) {
            n += 1
        }
    }
    return n
}
