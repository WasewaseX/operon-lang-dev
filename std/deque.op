# std/deque — double-ended queue + FIFO queue over plain lists.
#
# Pure library: every function returns a NEW list (or a [value, rest] pair)
# and never mutates its argument. This matters because assignment SHARES
# containers (SPEC §19): each function starts from a fresh slice-copy of its
# input. The underlying list keeps insertion order; the front is index 0,
# the back is the last element.
#
# Honest cost model: back operations are O(1) amortized (the native push/pop),
# front operations are O(n) (slice rebuild). For long queues with heavy front
# traffic, restructure the algorithm — this module trades cost for zero new
# engine surface.
#
# Pins: tests/std_deque.op + tests/differential/deque.op (byte-identical).

gene __dq_copy(xs) {
    # fresh list with the same elements (shallow — matches §19 sharing)
    return xs.slice(0, len(xs))
}

gene deque_from(xs) {
    # new deque from an existing list (copy, order preserved)
    return __dq_copy(xs)
}

gene deque_push_back(dq, v) {
    # add at the back — O(1) amortized
    let out = __dq_copy(dq)
    push(out, v)
    return out
}

gene deque_push_front(dq, v) {
    # add at the front — O(n)
    return [v] + dq
}

gene deque_pop_back(dq) {
    # remove from the back — returns [value, rest]; [null, []] when empty
    if len(dq) == 0 {
        return [null, []]
    }
    return [dq[len(dq) - 1], dq.slice(0, len(dq) - 1)]
}

gene deque_pop_front(dq) {
    # remove from the front — returns [value, rest]; [null, []] when empty
    if len(dq) == 0 {
        return [null, []]
    }
    return [dq[0], dq.slice(1, len(dq))]
}

gene deque_peek_front(dq) {
    # front value without removing; null when empty
    if len(dq) == 0 {
        return null
    }
    return dq[0]
}

gene deque_peek_back(dq) {
    # back value without removing; null when empty
    if len(dq) == 0 {
        return null
    }
    return dq[len(dq) - 1]
}

gene queue_new() {
    # FIFO queue alias: push with queue_push, pop with queue_pop
    return []
}

gene queue_push(q, v) {
    # enqueue at the back
    return deque_push_back(q, v)
}

gene queue_pop(q) {
    # dequeue from the front — returns [value, rest]; [null, []] when empty
    return deque_pop_front(q)
}

gene queue_len(q) {
    return len(q)
}
