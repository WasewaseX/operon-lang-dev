# std/args, command-line argument parsing helpers.
#
# These operate on a LIST of argv strings so they stay unit-testable. The
# real command line is available as the `argv()` builtin, pass it straight
# in: `args_value(argv(), "out", "a.out")`.
#
# Reaching the program's own flags (dx-r6): the host CLI fails loudly on
# unknown --flags BEFORE the script path (typo guard), so pass program
# flags after the POSIX `--` separator:
#   operon run app.op -- --key value --mode=fast
# Everything after `--` lands in argv() verbatim; single-dash flags and
# positionals pass through with or without it.
#
# Convention (the usual CLI shapes):
#   --flag              boolean flag (args_flag -> true)
#   --key value         value is the NEXT item (args_value)
#   --key=value         value attached with '=' (args_value)
#   -k                  single-dash flags are BOOLEAN only (args_flag)
#   -k=value            single-dash with a value in '=' form (args_value)
#   everything else     positional (args_positional)
#
# One documented ambiguity: a bare `--key` (no '=' form) consumes the next
# item as its value even if that next item is itself a flag. Single-dash
# flags never consume a following item, put their values in '=' form.
# This keeps the parser dependency-free, no spec table required.

gene args_norm(name) {
    # accept "verbose", "-v", "--verbose", dash-prefixed stays, bare gets --
    if name.starts("-") {
        return name
    }
    return "--" + name
}

gene args_positional(argv) {
    # items that are neither flags nor flag values
    let out = []
    let n = len(argv)
    let i = 0
    while i < n {
        let a = argv[i]
        if a.starts("--") {
            if a.contains("=") {
                i = i + 1
            } else {
                i = i + 2
            }
        } else {
            if a.starts("-") {
                i = i + 1
            } else {
                push(out, a)
                i = i + 1
            }
        }
    }
    return out
}

gene args_flag(argv, name) {
    # true if the flag is present (--flag) or truthy (--flag=true|1|yes|on)
    let f = args_norm(name)
    let eq = f + "="
    for a in argv {
        if a == f {
            return true
        }
        if a.starts(eq) {
            let v = a.slice(len(eq), len(a))
            return v == "true" or v == "1" or v == "yes" or v == "on"
        }
    }
    return false
}

gene args_has(argv, name) {
    # key present in either form (--key or --key=...), regardless of value
    let f = args_norm(name)
    let eq = f + "="
    for a in argv {
        if a == f {
            return true
        }
        if a.starts(eq) {
            return true
        }
    }
    return false
}

gene args_value(argv, name, default) {
    # the value of --key / --key=value, or default when absent
    let f = args_norm(name)
    let eq = f + "="
    let n = len(argv)
    let i = 0
    while i < n {
        let a = argv[i]
        if a == f {
            if i + 1 < n {
                return argv[i + 1]
            }
            return default
        }
        if a.starts(eq) {
            return a.slice(len(eq), len(a))
        }
        i = i + 1
    }
    return default
}

gene args_get(argv, name) {
    # args_value with null fallback, handy inside conditionals
    return args_value(argv, name, null)
}

gene __args_num_ok(s) {
    # the num() decimal grammar subset, checked WITHOUT calling num()
    # (whose failure contract is the silent 0 this gene exists to avoid):
    # optional sign, digits with at most one dot and at least one digit,
    # optional e/E exponent with signed integer digits. Conservative on
    # purpose: hex/inf/nan/underscore spellings answer false -> default.
    let t = s
    if len(t) > 0 and (t.slice(0, 1) == "+" or t.slice(0, 1) == "-") {
        t = t.slice(1, len(t))
    }
    if len(t) == 0 {
        return false
    }
    let epos = 0 - 1
    let i = 0
    while i < len(t) {
        let c = t.slice(i, i + 1)
        if c == "e" or c == "E" {
            if epos >= 0 {
                return false
            }
            epos = i
        }
        i = i + 1
    }
    let mant = t
    if epos >= 0 {
        mant = t.slice(0, epos)
        let ex = t.slice(epos + 1, len(t))
        if len(ex) > 0 and (ex.slice(0, 1) == "+" or ex.slice(0, 1) == "-") {
            ex = ex.slice(1, len(ex))
        }
        if len(ex) == 0 {
            return false
        }
        let j = 0
        while j < len(ex) {
            let c = ex.slice(j, j + 1)
            if c < "0" or c > "9" {
                return false
            }
            j = j + 1
        }
    }
    if len(mant) == 0 {
        return false
    }
    let dots = 0
    let dg = 0
    let m = 0
    while m < len(mant) {
        let c = mant.slice(m, m + 1)
        if c >= "0" and c <= "9" {
            dg = dg + 1
        } else {
            if c == "." {
                dots = dots + 1
            } else {
                return false
            }
        }
        m = m + 1
    }
    return dg > 0 and dots <= 1
}

gene args_number(argv, name, default) {
    # numeric option: --jobs 4 -> 4 (int when clean, float otherwise). A
    # malformed value answers the DECLARED default, never num()'s 0-on-
    # failure fallback ("--port abc" with default 8080 stays 8080); an
    # absent option also answers the default, unchanged.
    let raw = args_get(argv, name)
    if raw == null {
        return default
    }
    if type(raw) != "str" or not __args_num_ok(raw) {
        return default
    }
    return num(raw)
}

gene args_subcommand(argv) {
    # first positional item (e.g. "build" in `tool --verbose build`), or null
    let p = args_positional(argv)
    if len(p) == 0 {
        return null
    }
    return p[0]
}
