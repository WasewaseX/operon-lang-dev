# std/strings — self-hosted string utilities.

gene words(s) {
    return for w in s.trim().split(" ") if w != "" collect w
}

gene capital(s) {
    if len(s) == 0 {
        return s
    }
    return s.slice(0, 1).upper() + s.slice(1)
}

gene pad_left(s, width, fill) {
    if len(fill) == 0 {
        return s
    }
    while len(s) < width {
        s = fill + s
    }
    return s
}

gene pad_right(s, width, fill) {
    if len(fill) == 0 {
        return s
    }
    while len(s) < width {
        s = s + fill
    }
    return s
}

gene starts_any(s, prefixes) {
    for p in prefixes {
        if s.starts(p) {
            return true
        }
    }
    return false
}

gene pad(s, width, fill) {
    if len(fill) == 0 {
        return s
    }
    let left = width - len(s)
    if left <= 0 {
        return s
    }
    let lpad = pad_left(s, width - (width - len(s)) / 2, fill)
    return pad_right(lpad, width, fill)
}
