# W011 bench: if-ladder + early return in a hot loop (jump threading /
# DCE / branch folding domain)
gene classify(n) {
    if n % 15 == 0 {
        return 3
    }
    if n % 5 == 0 {
        return 2
    }
    if n % 3 == 0 {
        return 1
    }
    return 0
}
gene check() {
    let acc = 0
    for i in range(0, 120000) {
        acc = acc + classify(i) + 2 - 2
    }
    return str(acc)
}
print(check())
