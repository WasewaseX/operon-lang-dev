# bench: module-heavy — six local modules imported at startup, called in a
# loop (W083). Measures the import machinery (resolution table SPEC §8,
# module cache, TAD insulation) plus cross-module call overhead. There is
# no algorithmic Python mirror: the "native" column for this workload is
# CPython's cached import machinery over six real stdlib modules, which is
# a shape comparison, not an algorithm parity (BENCH.md notes this).
use scripts/bench/mods/m_a;
use scripts/bench/mods/m_b;
use scripts/bench/mods/m_c;
use scripts/bench/mods/m_d;
use scripts/bench/mods/m_e;
use scripts/bench/mods/m_f;

main {
    let acc = 0
    for i in range(20000) {
        acc = acc + m_a.ma(i) + m_b.mb(i) + m_c.mc(i) + m_d.md(i) + m_e.me(i) + m_f.mf(i)
    }
    promote("modules acc = {acc}")
}
