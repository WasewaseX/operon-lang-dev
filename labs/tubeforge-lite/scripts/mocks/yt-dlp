#!/usr/bin/env bash
# Mock yt-dlp for TubeForge Lite e2e — hermetic, no network.
# Supports: --version | -J (fixture) | download run with progress lines.
# A URL containing "#slow" makes the download take ~4s (for cancel tests).
if [ "$1" = "--version" ]; then echo "2026.01.01-tfmock"; exit 0; fi
if [ "$1" = "-J" ]; then cat "$(dirname "$0")/fixture.json"; exit 0; fi

out=""; prev=""
for a in "$@"; do
  if [ "$prev" = "-o" ]; then out="$a"; fi
  if [ "$a" = "-o" ]; then prev="-o"; else prev="$a"; fi
done
url="${*: -1}"
ext="mp4"
case "$*" in *--audio-format*) ext="mp3";; esac

dir="$(dirname "$out")"
mkdir -p "$dir"
path="$dir/Mock Video [mock001].$ext"

if [[ "$url" == *#slow* ]]; then
  steps=(10 20 30 40 50 60 70 80 90 99)
  sleepstep=0.35
else
  steps=(25 55 80 100)
  sleepstep=0.05
fi
for p in "${steps[@]}"; do
  echo "__TFPROG__|${p}%| 3.00MiB/s|00:04|102400|${p}0000|1000000"
  sleep "$sleepstep"
done

head -c 200000 /dev/urandom > "$path"
echo "__TFDONE__|$path"
exit 0
