            "text": "fn arity_ok_not_flagged() {\n        let f = lint_src(\"gene add(a, b) {\\n    return a + b\\n}\\nlet x = add(1, 2)\\n\");\n        assert!(!has_rule(&f, \"wrong-arity\"), \"{:?}\", f);\n    }\n\n    #[test]\n    fn arity_defaults_extend_max() {\n        let f = lint_src(\"gene g(a, b, c) {\\n    return"
          },
