# demo_pkg - checked-in fixture exercising the registry-installed package
# layout (operon_modules/<pkg>/<pkg>.op) through the real import path.
# Consumed by tests/differential/package_resolve.op on BOTH cores; the
# resolution candidates live in genes.rs resolve_path and oracle.py
# load_module and must stay mirrored (ai/ecosystem, W19).

gene twice(n) {
    return n * 2;
}

gene shout(s) {
    return s.upper() + "!";
}

let label = "demo";
let version = [1, 0, 0];
