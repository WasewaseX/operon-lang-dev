
# C5/D4, positive autoregulation (two-tier loop a -> ap -> a) + hysteresis sweep
ligand ind
decay_clock(1, 0.0)
regulate {
    ind activates a strength 1.0 threshold 0.5 any
    a translates ap rate 0.6 decay 0.5
    ap activates a strength 1.0 threshold 0.5
}
gene a() { return "a-tx" }
gene tick() { return "tick" }
frame proof {
    # ---- UP sweep: no protein yet, only the input arm can open the gate
    ligand_set("ind", 0.1)
    assert(a() == null, "up L=0.1: OFF (no protein, no input)")
    ligand_set("ind", 0.2)
    assert(a() == null, "up L=0.2: OFF")
    ligand_set("ind", 0.3)
    assert(a() == null, "up L=0.3: OFF")
    ligand_set("ind", 0.4)
    assert(a() == null, "up L=0.4: OFF, the switch point is above 0.4")
    ligand_set("ind", 0.5)
    assert(a() == "a-tx", "up L=0.5: input arm opens; A transcribes")
    assert(grn_get("ap") - 0.6 < 1e-12, "A's own protein accumulated (0.6)")
    # ---- DOWN sweep: the SELF-arm holds the gate open below the input threshold
    ligand_set("ind", 0.4)
    assert(a() == "a-tx", "DOWN L=0.4: ON (was OFF on the way up), HYSTERESIS")
    ligand_set("ind", 0.3)
    assert(a() == "a-tx", "DOWN L=0.3: ON (memory)")
    ligand_set("ind", 0.2)
    assert(a() == "a-tx", "DOWN L=0.2: ON (memory)")
    ligand_set("ind", 0.1)
    assert(a() == "a-tx", "DOWN L=0.1: ON (memory)")
    ligand_set("ind", 0.0)
    assert(a() == "a-tx", "DOWN L=0.0: self-sustaining with NO input")
    assert(grn_get("ap") > 0.9, "self-arm keeps the protein saturated")
    # ---- dilution drains the self-arm: the OFF state is absorbing too
    tick()
    tick()
    assert(grn_get("ap") < 0.5, "two idle ticks halve the protein twice (0.25)")
    assert(a() == null, "drained: gate shuts at L=0, bistable OFF")
    assert(a() == null, "OFF is absorbing: no re-arm without input")
}
main { promote("autoreg hysteresis done") }