# Core values, arithmetic, strings, proofs run by `operon test`
frame proof {
    assert(1 + 2 == 3, "int add")
    assert(7 // 2 == 3, "floor div")
    assert(7 % 4 == 3, "floored remainder")
    assert(2 + 3.0 == 5.0, "int/float promote")
    assert(10 / 4 == 2.5, "true division is float")
    assert(-5 + 2 == -3, "negatives")
    assert("ab" + "cd" == "abcd", "str concat")
    assert([1] + [2, 3] == [1, 2, 3], "list concat")
    assert(2 * 3 + 4 == 10, "precedence mul over add")
    assert(2 + 3 * 4 == 14, "precedence 2")
    assert(-(3 + 4) == -7, "unary neg grouping")
    assert(not false, "not")
    assert(true and not false, "and/not")
    assert(false or true, "or")
    assert("abc".upper() == "ABC", "str upper")
    assert("  x ".trim() == "x", "trim")
    assert("a,b,c".split(",").len() == 3, "split")
    assert("-".join(["a", "b"]) == "a-b", "join")
    assert("hello".replace("l", "L") == "heLLo", "replace")
    assert("hi".repeat(3) == "hihihi", "repeat")
    assert("hello".slice(1, 3) == "el", "slice")
    assert("abcdef".contains("cde"), "contains")
    assert("op" + str(42) == "op42", "str() coercion")
    let n = num("321")
    assert(n == 321, "num() parse")
    assert(len("genome") == 6, "len str")
    assert(len([1, 2, 3, 4]) == 4, "len list")
    assert(type(1) == "int" and type(1.0) == "float" and type("x") == "str", "type names")
    assert(type(null) == "null", "null type")
    let name = "operon"
    assert("run {name} v{2 * 21}" == "run operon v42", "interpolation")
}
