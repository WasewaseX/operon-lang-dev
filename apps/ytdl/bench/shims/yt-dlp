#!/usr/bin/env python3
# Deterministic offline yt-dlp shim — reproducible benchmarking without
# network. Env knobs:
#   SHIM_DELAY_JSON   sleep before -J output (default 0.05 s)
#   SHIM_DELAY_DL     sleep before download completes (default 0.2 s)
#   SHIM_SIZE         bytes written per download (default 1048576)
#   SHIM_FAIL=1       downloads exit 1 (error-handling benchmark)
#   SHIM_DELAY_SPAWN  sleep before ANY command answers (default 0.01 s)
import json
import os
import sys
import time

D_JSON = float(os.environ.get("SHIM_DELAY_JSON", "0.05"))
D_DL = float(os.environ.get("SHIM_DELAY_DL", "0.2"))
SIZE = int(os.environ.get("SHIM_SIZE", "1048576"))
FAIL = os.environ.get("SHIM_FAIL", "0") == "1"
D_SPAWN = float(os.environ.get("SHIM_DELAY_SPAWN", "0.01"))


def fmt_json():
    formats = []
    for i in range(1, 13):
        formats.append({
            "format_id": f"{137+i}",
            "ext": "mp4" if i % 2 else "webm",
            "height": 1080 - i * 40,
            "vcodec": "avc1" if i % 2 else "vp9",
            "acodec": "mp4a" if i % 2 else "opus",
            "tbr": 4000 - i * 100,
        })
    return {
        "id": "shim_video_001",
        "title": "Shim deterministic video",
        "uploader": "shim",
        "duration": 213.4,
        "formats": formats,
    }


def out_path(argv):
    # -o template appears after -o; replace template placeholders like
    # yt-dlp would, deterministically.
    if "-o" in argv:
        tpl = argv[argv.index("-o") + 1]
        return tpl.replace("%(title)s", "Shim_deterministic_video").replace(
            "%(ext)s", "mp4"
        )
    return "downloads/Shim_deterministic_video.mp4"


def main():
    argv = sys.argv[1:]
    if D_SPAWN:
        time.sleep(D_SPAWN)
    if not argv or argv[0] in ("--version",):
        print("2026.08.19-shim")
        return 0
    if argv[0] == "-J":
        time.sleep(D_JSON)
        json.dump(fmt_json(), sys.stdout)
        sys.stdout.write("\n")
        return 0
    if "--no-warnings" in argv or "-f" in argv or "-x" in argv or "--write-subs" in argv:
        # download-shaped invocation
        # URL-driven deterministic failure: any url containing "/fail/"
        # fails (env vars are scrubbed by sandboxed hosts like Operon,
        # so SHIM_FAIL is reserved for non-sandboxed hosts only).
        urls = [a for a in argv if a.startswith("http")]
        if FAIL or any("/fail/" in u for u in urls):
            sys.stderr.write("ERROR: [shim] requested download failed deterministically\n")
            return 1
        time.sleep(D_DL)
        p = out_path(argv)
        d = os.path.dirname(p)
        if d:
            os.makedirs(d, exist_ok=True)
        with open(p, "wb") as fh:
            fh.write(b"\0" * SIZE)
        sys.stdout.write(f"[shim] downloaded -> {p}\n")
        return 0
    sys.stderr.write(f"ERROR: [shim] unsupported invocation: {' '.join(argv)}\n")
    return 1


if __name__ == "__main__":
    sys.exit(main())
