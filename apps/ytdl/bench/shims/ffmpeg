#!/usr/bin/env python3
# Deterministic ffmpeg shim — offline audio-extract benchmarking.
import os
import sys
import time

D = float(os.environ.get("SHIM_DELAY_FFMPEG", "0.05"))

def main():
    argv = sys.argv[1:]
    if argv and argv[0] == "-version":
        print("ffmpeg version 7.1.5-shim")
        return 0
    if "-i" in argv:
        time.sleep(D)
        out = argv[-1]
        d = os.path.dirname(out)
        if d:
            os.makedirs(d, exist_ok=True)
        with open(out, "wb") as fh:
            fh.write(b"\0" * 131072)
        return 0
    sys.stderr.write("ERROR: [shim] unsupported ffmpeg invocation\n")
    return 1

if __name__ == "__main__":
    sys.exit(main())
