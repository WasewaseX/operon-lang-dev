# ============================================================
# Vending machine FSM  — cookbook #05
# you already know: a state machine as a dict of dicts
# teaches: nested maps as transition tables, while-style loops,
#          state reset on terminal transition
# run: operon run examples/cookbook/fsm_vending.op
# expected output: examples/cookbook/expected/fsm_vending.out
# verified by scripts/cookbook.sh on the Rust core AND the Python oracle
# ============================================================
gene step(state, coin) {
    # s0=0c s5=5c s10=10c s15=15c s20=20c; vend at >= 25c
    let machine = {
        "s0":  {"n": "s5",   "d": "s10",  "q": "vend"},
        "s5":  {"n": "s10",  "d": "s15",  "q": "vend"},
        "s10": {"n": "s15",  "d": "s20",  "q": "vend"},
        "s15": {"n": "s20",  "d": "vend", "q": "vend"},
        "s20": {"n": "vend", "d": "vend", "q": "vend"}
    }
    return machine[state][coin]
}

gene main() {
    let coins = ["n", "d", "n", "n", "d", "q", "n"]
    let state = "s0"
    let vends = 0

    for c in coins {
        let next_state = step(state, c)
        promote("{state} --{c}--> {next_state}")
        if next_state == "vend" {
            vends += 1
            state = "s0"          # machine resets after dispensing
        } else {
            state = next_state
        }
    }
    promote("vended {vends} items; final state {state}")
}
