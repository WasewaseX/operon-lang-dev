# ============================================================
# Primes & Goldbach  — cookbook #12
# you already know: a sieve + a nested search for pairs
# teaches: boolean-list sieves, break/continue-free control flow,
#          early return from a scan gene
# run: operon run examples/cookbook/primes.op
# expected output: examples/cookbook/expected/primes.out
# verified by scripts/cookbook.sh on the Rust core AND the Python oracle
# ============================================================
gene sieve(limit) {
    # is_composite[i] true when i has a factor; 0 and 1 marked up front
    let is_composite = []
    for i in range(0, limit + 1) {
        push(is_composite, i < 2)
    }
    let p = 2
    while p * p <= limit {
        if not is_composite[p] {
            let multiple = p * p
            while multiple <= limit {
                is_composite[multiple] = true
                multiple += p
            }
        }
        p += 1
    }
    let primes = []
    for i in range(2, limit + 1) {
        if not is_composite[i] {
            push(primes, i)
        }
    }
    return primes
}

gene goldbach_pair(n, primes) {
    # every even n > 2 tested here is the sum of two primes
    for p in primes {
        if p > n / 2 {
            return null
        }
        let q = n - p
        if primes.contains(q) {
            return [p, q]
        }
    }
    return null
}

gene main() {
    let primes = sieve(50)
    promote("primes to 50: {primes}")
    promote("count: {len(primes)}")

    for n in [28, 36, 48] {
        let pair = goldbach_pair(n, primes)
        promote("{n} = {pair[0]} + {pair[1]}")
    }
}
