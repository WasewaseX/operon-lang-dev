# Vendored from master-ci v1.16.0 + operon house tailoring.
#
# Layering: this file enforces BYTE HYGIENE everywhere (charset, line
# endings, final newline, trailing whitespace). LAYOUT (indentation) is
# the contract of the dedicated formatters that run in the same CI —
# rustfmt for .rs (cargo fmt --check), ruff format for .py — so the
# generic indent rules are unset for those languages. The remaining
# unset sections are generated artifacts and pinned-byte fixtures whose
# exact bytes are load-bearing (diffed by the house checkers or
# regenerated by their own tools).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = unset

[*.rs]
indent_size = unset

[*.go]
indent_style = tab
indent_size = unset

[*.op]
indent_size = unset

[*.sh]
indent_size = unset

[*.md]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# --- generated / pinned data: bytes are load-bearing ---
[apps/*/bench/*.json]
indent_size = unset
insert_final_newline = unset

[apps/ytdl/test/mock/fixtures/*.json]
indent_size = unset

[docs/bench/*.json]
indent_size = unset
insert_final_newline = unset

[docs/bench/*/*.json]
indent_size = unset
insert_final_newline = unset

[docs/stats.json]
indent_size = unset

[docs/perf/*.json]
indent_size = unset
insert_final_newline = unset

[docs/grammar.html]
indent_size = unset
insert_final_newline = unset

[docs/static-analysis/reports/*]
indent_size = unset
insert_final_newline = unset

[tests/compat/MANIFEST.json]
indent_size = unset
insert_final_newline = unset

[apps/csvstat/test/data/*.csv]
trim_trailing_whitespace = unset
indent_size = unset
insert_final_newline = unset

[tests/diagnostics/expected/*.txt]
trim_trailing_whitespace = unset
insert_final_newline = unset
indent_size = unset

[tests/granted/**/fixture.txt]
trim_trailing_whitespace = unset
insert_final_newline = unset

[tests/redteam/*.cell]
trim_trailing_whitespace = unset
insert_final_newline = unset

[examples/cookbook/expected/*.out]
trim_trailing_whitespace = unset
insert_final_newline = unset
indent_size = unset

[fuzz/seeds/*.op]
indent_size = unset
insert_final_newline = unset

[fuzz_corpus/*.op]
indent_size = unset
insert_final_newline = unset

# --- experiment trees ---
[labs/**]
indent_style = unset
indent_size = unset
insert_final_newline = unset
end_of_line = unset

# --- .op corpus: byte-pinned test programs (differential + fuzz + redteam
# encoding tests deliberately carry BOM/CRLF/NUL/latin-1 bytes) ---
[tests/**/*.op]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[fuzz/seeds/*.op]
charset = unset
end_of_line = unset

[fuzz_corpus/*.op]
charset = unset
end_of_line = unset
